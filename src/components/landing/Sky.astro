---
/**
 * The one night sky behind the whole landing. Layers, back to front:
 *   base    – brand gradients: pink warmth on the Shop side, moonlight on the Divination side
 *   stars   – three static SVG fields (far / mid / near) that twinkle and drift at different depths
 *   glints  – a few larger four-point stars
 *   mist    – slow banks of soft light and one of shadow
 *   beam    – a wide, faint shaft of light that crosses the sky
 *   meteor  – a rare, quiet streak
 * Everything is decorative (aria-hidden) and animates transform/opacity only.
 */
import { starField } from '~/lib/landing-fx';

const fields = [
  { key: 'far', depth: 4, stars: starField(70, 11, [0.6, 1.2]) },
  { key: 'mid', depth: 9, stars: starField(46, 23, [0.8, 1.6]) },
  { key: 'near', depth: 16, stars: starField(22, 37, [1.1, 2.1]) },
];
const glints = [
  { x: 14, y: 12, s: 14, d: 0 }, { x: 82, y: 9, s: 10, d: 1.8 }, { x: 68, y: 33, s: 12, d: 3.1 },
  { x: 8, y: 47, s: 9, d: 4.4 }, { x: 91, y: 58, s: 13, d: 0.9 }, { x: 36, y: 86, s: 10, d: 2.6 },
];
---
<div class="sky" aria-hidden="true">
  <div class="sky__base"></div>
  {fields.map((f) => (
    <div class="sky__par" data-depth={f.depth}>
      <svg class:list={['stars', `stars--${f.key}`]} viewBox="0 0 1000 1000" preserveAspectRatio="xMidYMid slice" focusable="false">
        {f.stars.map((s) => <circle cx={s.x} cy={s.y} r={s.r} />)}
      </svg>
    </div>
  ))}
  <div class="sky__par" data-depth="14">
    {glints.map((g) => <i class="glint" style={`left:${g.x}%;top:${g.y}%;--g:${g.s}px;--gd:${g.d}s`}></i>)}
  </div>
  <div class="sky__par" data-depth="22">
    <i class="mist mist--pink"></i>
    <i class="mist mist--moon"></i>
    <i class="mist mist--shade"></i>
  </div>
  <i class="sky__beam"></i>
  <i class="meteor"></i>
</div>

<style>
  .sky { position: fixed; inset: 0; z-index: -1; overflow: hidden; pointer-events: none; contain: strict; }
  .sky__base {
    position: absolute; inset: 0;
    background:
      radial-gradient(60% 42% at var(--pink-x, 18%) var(--pink-y, 30%), color-mix(in srgb, var(--pink) 15%, transparent), transparent 72%),
      radial-gradient(56% 42% at var(--moon-x, 82%) var(--moon-y, 74%), color-mix(in srgb, var(--warm-white) 9%, transparent), transparent 72%),
      radial-gradient(50% 36% at 50% 50%, color-mix(in srgb, var(--pink) 7%, transparent), transparent 75%),
      radial-gradient(130% 100% at 50% 42%, var(--noir) 0%, var(--noir-deep) 100%);
  }
  .sky__par { position: absolute; inset: -3%; will-change: transform; }

  .stars { position: absolute; inset: 0; width: 100%; height: 100%; fill: var(--warm-white); }
  .stars--far { opacity: 0.55; }
  .stars--mid { opacity: 0.7; }
  .stars--near { opacity: 0.9; fill: var(--soft-pink); }

  .glint { position: absolute; width: var(--g); height: var(--g); translate: -50% -50%; opacity: 0.75; }
  .glint::before, .glint::after { content: ''; position: absolute; inset: 0; background: var(--warm-white); }
  .glint::before { clip-path: polygon(50% 0, 56% 44%, 100% 50%, 56% 56%, 50% 100%, 44% 56%, 0 50%, 44% 44%); }
  .glint::after { display: none; }

  .mist { position: absolute; width: 110vw; height: 42svh; border-radius: 50%; opacity: 0.55; }
  .mist--pink { left: -30vw; top: 10svh; background: radial-gradient(closest-side, color-mix(in srgb, var(--pink) 11%, transparent), transparent); }
  .mist--moon { right: -34vw; bottom: 4svh; background: radial-gradient(closest-side, color-mix(in srgb, var(--warm-white) 9%, transparent), transparent); }
  .mist--shade { left: -10vw; top: 38svh; height: 38svh; opacity: 0.8; background: radial-gradient(closest-side, color-mix(in srgb, #000 55%, transparent), transparent); }

  .sky__beam {
    position: absolute; inset: -10% -25%; opacity: 0.6;
    background: linear-gradient(104deg, transparent 38%, color-mix(in srgb, var(--warm-white) 5%, transparent) 50%, transparent 62%);
  }
  .meteor { position: absolute; left: 62%; top: 8%; width: 7rem; height: 1px; opacity: 0; background: linear-gradient(90deg, transparent, var(--warm-white)); transform: rotate(28deg); }

  @media (min-width: 48rem) {
    .sky__base { --pink-x: 24%; --pink-y: 66%; --moon-x: 76%; --moon-y: 30%; }
    .mist { width: 52vw; height: 52svh; }
    .mist--pink { left: -12vw; top: auto; bottom: 0; }
    .mist--moon { right: -14vw; top: 4svh; bottom: auto; }
    .mist--shade { left: 15vw; top: 30svh; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .sky { animation: sky-in 2.2s ease-out backwards; }
    .stars--near { animation: twinkle 4.8s ease-in-out -1s infinite alternate; }
    .glint { animation: glint 5.5s ease-in-out var(--gd) infinite; }
    .mist--pink { animation: drift-a 46s ease-in-out infinite alternate; }
    .mist--moon { animation: drift-b 58s ease-in-out infinite alternate; }
    .mist--shade { animation: drift-a 71s ease-in-out -20s infinite alternate-reverse; }
    .sky__beam { animation: beam 26s ease-in-out infinite alternate; }
    .meteor { animation: meteor 17s ease-in 6s infinite; }

    @keyframes sky-in { from { opacity: 0; } }
    @keyframes twinkle { from { opacity: var(--lo, 0.35); } to { opacity: var(--hi, 0.95); } }
    @keyframes glint { 0%, 100% { opacity: 0.15; scale: 0.6; } 50% { opacity: 0.95; scale: 1; } }
    @keyframes drift-a { from { transform: translate3d(-6vw, 0, 0); } to { transform: translate3d(10vw, -3svh, 0); } }
    @keyframes drift-b { from { transform: translate3d(6vw, 2svh, 0); } to { transform: translate3d(-10vw, -2svh, 0); } }
    @keyframes beam { from { transform: translate3d(-12%, 0, 0); } to { transform: translate3d(12%, 0, 0); } }
    @keyframes meteor {
      0% { opacity: 0; transform: translate3d(0, 0, 0) rotate(28deg); }
      3% { opacity: 0.85; }
      9% { opacity: 0; transform: translate3d(-34vw, 20svh, 0) rotate(28deg); }
      100% { opacity: 0; transform: translate3d(-34vw, 20svh, 0) rotate(28deg); }
    }
  }
  /* Lite mode: fewer, simpler layers on slow devices. */
  :global([data-fx='lite']) .mist--shade, :global([data-fx='lite']) .sky__beam, :global([data-fx='lite']) .meteor,
  :global([data-fx='lite']) .glint { display: none; }
  :global([data-fx='lite']) :is(.stars, .mist) { animation: none; }
</style>
