---
/**
 * The official LaNoir logo. Never retype or redraw it — always use this.
 * How the asset is built lives in ~/config/logo.ts so it can be swapped for a
 * transparent PNG/SVG without touching any layout.
 *
 * Props
 *  - variant: `full` (master artwork, large placements, >=320px) or `icon` (LN monogram,
 *            small placements such as header, menu, favicon).
 *  - width: any CSS length.
 *  - plate: draw the approved Logo Charcoal ground (required for the raster).
 *  - eager: for above-the-fold use.
 */
import { Image } from 'astro:assets';
import { logo, logoIcon } from '~/config/logo';

interface Props {
  /** `full` = master artwork (large placements). `icon` = LN monogram (header, menu, small). */
  variant?: 'full' | 'icon';
  width?: string;
  plate?: boolean;
  eager?: boolean;
  /** `sizes` hint; defaults to the width. Must be an absolute length or viewport unit. */
  sizes?: string;
  class?: string;
}
const { variant = 'full', width = '20rem', plate = true, eager = false, sizes, class: className } = Astro.props;

const c = logo.crop;
// The cropped <img> renders wider than its container, so scale the `sizes` hint to match.
const base = sizes ?? `min(${width}, 100vw)`;
const imgSizes = c ? `calc(${base} * ${(c.sourceW / c.w).toFixed(3)})` : base;
const style = [
  `--logo-w:${width}`,
  `--logo-ground:${logo.ground}`,
  c ? `--logo-ratio:${c.w}/${c.h}` : '',
  c ? `--logo-img-w:${(c.sourceW / c.w) * 100}%` : '',
  c ? `--logo-img-x:${(-c.x / c.w) * 100}%` : '',
  c ? `--logo-img-y:${(-c.y / c.w) * 100}%` : '',
].join(';');
---

{variant === 'icon' ? (
  <Image
    class:list={['logo-icon', { 'logo-icon--blend': logoIcon.blend }, className]}
    src={logoIcon.src}
    alt={logoIcon.alt}
    style={`--logo-icon-w:${width}`}
    widths={[112, 168, 224, 336]}
    sizes={sizes ?? width}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    decoding="async"
    format="webp"
  />
) : (
<span class:list={['logo', { 'logo--plate': plate, 'logo--cropped': !!c }, className]} style={style}>
  <Image
    class="logo__img"
    src={logo.src}
    alt={logo.alt}
    widths={[240, 480, 720, 960, 1440, 1920]}
    sizes={imgSizes}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    decoding="async"
    format="webp"
  />
</span>
)}

<style>
  .logo-icon { display: block; width: var(--logo-icon-w); max-width: 100%; height: auto; }
  /* The supplied icon has a black ground; on dark surfaces `screen` makes black transparent. */
  .logo-icon--blend { mix-blend-mode: screen; }
  .logo {
    display: block;
    width: var(--logo-w);
    max-width: 100%;
    line-height: 0;
    overflow: hidden;
  }
  .logo--plate { background: var(--logo-ground); }
  .logo--cropped { aspect-ratio: var(--logo-ratio); position: relative; }
  .logo__img { width: 100%; height: auto; }
  .logo--cropped .logo__img {
    position: absolute;
    max-width: none;
    width: var(--logo-img-w);
    left: var(--logo-img-x);
    /* percentage margins/offsets resolve against width, hence --logo-img-y is width-based */
    top: var(--logo-img-y);
  }
</style>
