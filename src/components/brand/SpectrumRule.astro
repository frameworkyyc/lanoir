---
/** Thin six-band Pride rule. ONLY for Pride Exclusive moments. */
---
<span class="spectrum" aria-hidden="true">
  <i style="--c:var(--pride-1)"></i><i style="--c:var(--pride-2)"></i><i style="--c:var(--pride-3)"></i>
  <i style="--c:var(--pride-4)"></i><i style="--c:var(--pride-5)"></i><i style="--c:var(--pride-6)"></i>
</span>
<style>
  .spectrum { display: grid; grid-template-columns: repeat(6, 1fr); height: 3px; width: 100%; }
  .spectrum i { background: var(--c); display: block; }
</style>
