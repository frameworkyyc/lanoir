---
import { primaryNav } from '~/config/site';
import Logo from '../brand/Logo.astro';
import MobileNav from './MobileNav.astro';
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => current === href || (href !== '/' && current.startsWith(href + '/'));
---

<header class="site-header" data-header>
  <div class="container-wide site-header__inner">
    <a class="site-header__logo" href="/" aria-label="LaNoir — home">
      <Logo variant="icon" width="var(--seal)" sizes="56px" eager />
    </a>

    <!-- Desktop navigation (≥ lg). Designed separately from the mobile panel. -->
    <nav class="dnav" aria-label="Primary">
      <ul class="list-reset dnav__list" role="list">
        {primaryNav.map((item) => (
          <li class:list={['dnav__item', { 'has-menu': item.children }]}>
            {item.children ? (
              <>
                <button
                  class="dnav__link t-label"
                  type="button"
                  aria-expanded="false"
                  aria-controls="collections-menu"
                  data-menu-trigger
                >
                  {item.label}
                  <svg class="dnav__chev" viewBox="0 0 10 6" width="9" height="6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.2" /></svg>
                </button>
                <div class="mega" id="collections-menu" data-menu-panel>
                  <div class="container-wide mega__inner">
                    <p class="mega__lead t-label">Signature collections</p>
                    <ul class="list-reset mega__list" role="list">
                      {item.children.map((c) => (
                        <li>
                          <a class="mega__link" href={c.href}>
                            <span class="mega__index t-label">{c.index}</span>
                            <span class="mega__name">{c.label}</span>
                            <span class="mega__note t-label">{c.note}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                    <a class="link-arrow mega__all" href={item.href}>All collections <span class="btn__arrow" aria-hidden="true">→</span></a>
                  </div>
                </div>
              </>
            ) : (
              <a class="dnav__link t-label" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__actions">
      <a class="icon-btn" href="/cart" aria-label="Cart" data-cart-open>
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round">
          <path d="M5 8h14l-1 12H6L5 8Z" /><path d="M9 8V6.5a3 3 0 0 1 6 0V8" />
        </svg>
        <span class="icon-btn__count t-label" data-cart-count hidden>0</span>
      </a>
      <button class="icon-btn menu-btn" type="button" aria-label="Open menu" aria-haspopup="dialog" aria-controls="mobile-nav" data-menu-open>
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M3 8h18M3 16h12" /></svg>
      </button>
    </div>
  </div>
</header>

<MobileNav />

<style>
  .site-header {
    --seal: 2.75rem;
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    /* Solid (no backdrop-filter): a filter isolates the icon's `screen` blend and would show its black ground. */
    background: var(--noir);
    border-bottom: var(--border-thin);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    min-height: var(--header-h);
  }
  .site-header__logo { display: block; flex: none; }
  .site-header__actions { display: flex; align-items: center; margin-right: -0.75rem; }

  .icon-btn {
    position: relative;
    display: grid;
    place-items: center;
    width: var(--touch);
    height: var(--touch);
    transition: color var(--dur-base);
  }
  .icon-btn:hover { color: var(--pink); }
  .icon-btn__count {
    position: absolute; top: 0.45rem; right: 0.25rem;
    min-width: 1.1rem; height: 1.1rem; padding: 0 0.25rem;
    display: grid; place-items: center;
    background: var(--pink); color: var(--noir); font-size: 0.6875rem; letter-spacing: 0;
  }
  .icon-btn__count[hidden] { display: none; }

  .dnav { display: none; }

  @media (min-width: 64rem) {
    .site-header { --seal: 3.25rem; }
    .dnav { display: block; flex: 1; margin-left: var(--space-l); }
    .menu-btn { display: none; }
    .site-header__actions { margin-right: -0.5rem; }
    .dnav__list { display: flex; align-items: center; gap: clamp(1rem, 2.2vw, 2.25rem); }
    .dnav__link {
      position: relative;
      display: inline-flex; align-items: center; gap: 0.45rem;
      min-height: var(--touch);
      letter-spacing: 0.14em;
      transition: color var(--dur-base);
    }
    .dnav__link::after {
      content: ''; position: absolute; left: 0; right: 0; bottom: 0.55rem; height: 1px;
      background: var(--pink);
      transform: scaleX(0); transform-origin: left;
      transition: transform var(--dur-base) var(--ease-out);
    }
    .dnav__link:hover, .dnav__link[aria-expanded='true'] { color: var(--pink); }
    .dnav__link:hover::after, .dnav__link[aria-current='page']::after, .dnav__link[aria-expanded='true']::after { transform: scaleX(1); }
    .dnav__chev { transition: transform var(--dur-base) var(--ease-out); }
    .dnav__link[aria-expanded='true'] .dnav__chev { transform: rotate(180deg); }
  }

  /* ---- Collections panel (desktop) ---- */
  .mega {
    position: absolute;
    left: 0; right: 0; top: 100%;
    background: var(--noir);
    border-bottom: var(--border-thin);
    visibility: hidden;
    opacity: 0;
    transform: translateY(-0.5rem);
    transition: opacity var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out), visibility 0s linear var(--dur-base);
  }
  .mega[data-open] { visibility: visible; opacity: 1; transform: none; transition-delay: 0s; }
  .mega__inner { display: grid; grid-template-columns: 12rem 1fr auto; align-items: center; gap: var(--space-l); padding-block: var(--space-l); }
  .mega__lead { color: var(--text-muted); }
  .mega__list { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-m); }
  .mega__link { display: grid; gap: 0.15rem; padding: 0.5rem 0; border-top: var(--border-thin); transition: border-color var(--dur-base); }
  .mega__link:hover { border-top-color: var(--pink); }
  .mega__index { color: var(--pink); }
  .mega__name { font-family: var(--font-display); font-size: 2.5rem; line-height: 1; text-transform: uppercase; transition: color var(--dur-base); }
  .mega__link:hover .mega__name { color: var(--pink); }
  .mega__note { color: var(--text-muted); font-size: 0.6875rem; }
</style>

<script>
  // Desktop collections panel: hover (pointer devices) + click/keyboard, Esc, outside click.
  const item = document.querySelector<HTMLElement>('.has-menu');
  const trigger = item?.querySelector<HTMLButtonElement>('[data-menu-trigger]');
  const panel = item?.querySelector<HTMLElement>('[data-menu-panel]');
  if (item && trigger && panel) {
    let timer: number | undefined;
    const set = (open: boolean) => {
      trigger.setAttribute('aria-expanded', String(open));
      panel.toggleAttribute('data-open', open);
    };
    const canHover = matchMedia('(hover: hover) and (pointer: fine)');
    trigger.addEventListener('click', () => set(trigger.getAttribute('aria-expanded') !== 'true'));
    item.addEventListener('mouseenter', () => { if (canHover.matches) { clearTimeout(timer); set(true); } });
    item.addEventListener('mouseleave', () => { if (canHover.matches) timer = window.setTimeout(() => set(false), 140); });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && trigger.getAttribute('aria-expanded') === 'true') { set(false); trigger.focus(); }
    });
    document.addEventListener('click', (e) => { if (!item.contains(e.target as Node)) set(false); });
    item.addEventListener('focusout', (e) => { if (!item.contains(e.relatedTarget as Node)) set(false); });
  }
</script>
