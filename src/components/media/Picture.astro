---
/**
 * Responsive image wrapper. One component for every photograph on the site.
 *  - With `media.src` (imported asset or remote URL): AVIF/WebP, srcset, lazy loading.
 *  - Without it: renders the neutral <Placeholder/>. Swapping in real photography
 *    therefore needs no layout change — just supply `src`.
 *
 * The wrapper owns the aspect ratio (prevents layout shift) and the crop.
 */
import type { Media } from '~/lib/commerce/types';
import Placeholder from './Placeholder.astro';
import ProductFallback from './ProductFallback.astro';
import { imageSrc, imageSrcset } from '~/lib/images';

interface Props {
  media?: Media;
  /** CSS aspect-ratio, e.g. "4/5". */
  ratio?: string;
  /** `sizes` attribute — describe how wide the image renders. */
  sizes?: string;
  widths?: number[];
  variant?: 'pretty-poison' | 'after-dark' | 'mystic-minis' | 'pride' | 'neutral';
  /** DEV-FACING description of the photo that belongs here (placeholders only). */
  label?: string;
  /** `contain` shows the whole picture (products); `cover` fills the frame (editorial). */
  fit?: 'cover' | 'contain';
  /** When set and there is no image, render the branded fallback with this name instead of the neutral placeholder. */
  fallbackTitle?: string;
  eager?: boolean;
  reveal?: boolean;
  class?: string;
}
const {
  media,
  ratio = '4/5',
  sizes = '(min-width: 64rem) 33vw, 100vw',
  widths = [360, 640, 960, 1440],
  variant = 'neutral',
  label,
  fit = 'cover',
  fallbackTitle,
  eager = false,
  reveal = false,
  class: className,
} = Astro.props;

const src = media?.src;
---

<div class:list={['media', `media--${fit}`, className]} style={`aspect-ratio:${ratio}`} data-reveal={reveal ? 'image' : undefined}>
  {
    typeof src === 'string' ? (
      // Remote image (Square CDN). Served as-is through ~/lib/images so transformations can be added later.
      <img
        class="media__img"
        src={imageSrc(src, { width: widths[widths.length - 1] })}
        srcset={imageSrcset(src, widths)}
        sizes={imageSrcset(src, widths) ? sizes : undefined}
        alt={media?.alt ?? ''}
        width={media?.width}
        height={media?.height}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
        decoding="async"
        referrerpolicy="no-referrer"
        style={media?.focal ? `object-position:${media.focal}` : undefined}
      />
    ) : src ? (
      // Local imported image: emitted as-is (no runtime transform on Workers). Prefer Square-hosted or public/ images.
      <img
        class="media__img"
        src={src.src}
        alt={media?.alt ?? ''}
        width={src.width}
        height={src.height}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
        decoding="async"
        style={media?.focal ? `object-position:${media.focal}` : undefined}
      />
    ) : fallbackTitle ? (
      <ProductFallback title={fallbackTitle} />
    ) : (
      <Placeholder variant={variant} label={label ?? media?.alt} />
    )
  }
</div>

<style>
  .media { position: relative; overflow: hidden; background: var(--noir-raised); }
  .media :global(.media__img),
  .media :global(picture),
  .media :global(picture img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .media--contain :global(.media__img), .media--contain :global(picture img) { object-fit: contain; }
  .media--contain { background: linear-gradient(160deg, color-mix(in srgb, var(--pink) 8%, var(--noir-raised)), var(--noir-deep)); }
</style>
