---
/** Every eligible Square product, so nothing in the catalogue is missing from the shop's front page. */
import type { Product } from '~/lib/commerce/types';
import ProductGrid from '../commerce/ProductGrid.astro';
import Eyebrow from '../brand/Eyebrow.astro';
interface Props { products: Product[] }
const { products } = Astro.props;
---
<section class="container-wide all" aria-labelledby="all-title">
  <div class="all__head">
    <div class="all__titles">
      <Eyebrow>Everything</Eyebrow>
      <h2 id="all-title" class="t-display-sm">The full <span class="text-pink">collection.</span></h2>
    </div>
    <a class="link-arrow" href="/shop">Shop all <span class="btn__arrow" aria-hidden="true">→</span></a>
  </div>
  <ProductGrid products={products.slice(0, 24)} cols={4} />
</section>
<style>
  .all { padding-block: var(--space-xl) 0; }
  .all__head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: var(--space-s); margin-bottom: var(--space-l); }
  .all__titles { display: grid; gap: var(--space-s); }
</style>
