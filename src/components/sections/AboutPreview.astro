---
import Picture from '../media/Picture.astro';
import Eyebrow from '../brand/Eyebrow.astro';
import Arc from '../brand/Arc.astro';
---
<section class="about section--lg" aria-labelledby="about-title">
  <div class="container-wide about__grid">
    <div class="about__media">
      <!-- PLACEHOLDER: about / behind-the-brand photograph (maker, studio or materials). Needs real imagery + story from the client. -->
      <Picture ratio="4/5" variant="neutral" label="ABOUT — behind-the-brand photograph (maker / studio / materials), portrait" sizes="(min-width: 64rem) 36vw, 80vw" reveal />
      <div class="about__arc" aria-hidden="true"><Arc sweep={0.45} rotate={30} /></div>
    </div>
    <div class="about__copy">
      <Eyebrow>About LaNoir</Eyebrow>
      <h2 id="about-title" class="t-statement about__statement" data-reveal>
        An attitude-based brand with dark feminine energy and an inclusive, rebellious edge.
      </h2>
      <p class="t-body t-muted" data-reveal style="--reveal-delay:100ms">
        Curated box sets, signature collections and wearable statements, connected through bold self-expression — not a narrow demographic.
      </p>
      <!-- TODO(client): replace with the real brand story / founder introduction. -->
      <a class="btn btn--ghost" href="/about" data-reveal style="--reveal-delay:160ms">About LaNoir <span class="btn__arrow" aria-hidden="true">→</span></a>
    </div>
  </div>
</section>
<style>
  .about { overflow: hidden; }
  .about__grid { display: grid; gap: var(--space-xl); }
  .about__media { position: relative; width: 82%; }
  .about__arc { position: absolute; width: 70%; aspect-ratio: 1; right: -38%; bottom: -14%; color: var(--pink); pointer-events: none; }
  .about__copy { display: grid; gap: var(--space-m); justify-items: start; align-content: center; }
  .about__statement { font-size: clamp(1.625rem, 1.2rem + 2vw, 2.75rem); }
  @media (min-width: 64rem) {
    .about__grid { grid-template-columns: 5fr 6fr; gap: var(--space-2xl); align-items: center; }
    .about__media { width: 100%; }
  }
</style>
