---
import type { Collection, Product } from '~/lib/commerce/types';
import { collectionUrl, productUrl } from '~/lib/routes';
import { priceLabel } from '~/lib/format';
import Picture from '../media/Picture.astro';
import Moon from '../brand/Moon.astro';
import type { Media } from '~/lib/commerce/types';

interface Props { collection: Collection; product?: Product; image?: Media; }
const { collection, product, image } = Astro.props;
---
<!-- Immersive break: one collection, big image, minimal copy. -->
<section class="feature" aria-labelledby="feature-title">
  <div class="feature__bg">
    <!-- PLACEHOLDER: After Dark full-bleed hero photograph. Dark, low-key, seductive and restrained. Safe area: keep subject on the right on desktop, upper half on mobile. -->
    <Picture media={image ?? collection.image} ratio="3/4" variant="after-dark" label="AFTER DARK — immersive full-bleed photograph (mobile 3:4, desktop 21:9 crop)" sizes="100vw" widths={[480, 800, 1200, 1800, 2400]} class="feature__pic" />
  </div>
  <div class="feature__scrim" aria-hidden="true"></div>
  <div class="container-wide feature__inner">
    <div class="feature__copy">
      <Moon size="2.5rem" class="feature__moon" />
      <p class="t-label text-pink" data-reveal>02 / After Dark</p>
      <h2 id="feature-title" class="feature__title" data-reveal style="--reveal-delay:80ms">Power<br />after hours.</h2>
      <p class="t-label feature__tag" data-reveal style="--reveal-delay:160ms">{collection.tagline}</p>
      <div class="feature__cta" data-reveal style="--reveal-delay:240ms">
        <a class="btn" href={collectionUrl(collection)}>Shop After Dark <span class="btn__arrow" aria-hidden="true">→</span></a>
        {product && <a class="link-arrow" href={productUrl(product.slug)}>{product.name} — {priceLabel(product)}</a>}
      </div>
    </div>
  </div>
</section>
<style>
  .feature { position: relative; display: grid; align-items: end; min-height: 38rem; background: var(--noir-deep); overflow: hidden; margin-block: var(--space-2xl); }
  .feature__bg { position: absolute; inset: 0; }
  .feature__bg :global(.media), .feature__bg :global(.feature__pic) { height: 100%; aspect-ratio: auto !important; }
  /* readability scrim for copy over photography (flat, no gradient) — only applies once a real photo is in */
  .feature__scrim { position: absolute; inset: 0; background: color-mix(in srgb, var(--noir-deep) 35%, transparent); pointer-events: none; }
  .feature__inner { position: relative; padding-block: var(--space-2xl); }
  .feature__copy { display: grid; gap: var(--space-s); justify-items: start; }
  .feature__moon { color: var(--warm-white); opacity: 0.8; }
  .feature__title { font-family: var(--font-statement); font-weight: 500; text-transform: uppercase; font-size: clamp(2.75rem, 11vw, 7rem); line-height: 1; letter-spacing: 0.06em; text-wrap: balance; }
  .feature__tag { color: var(--text-muted); max-width: 24rem; }
  .feature__cta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-s) var(--space-m); margin-top: var(--space-xs); }
  @media (min-width: 64rem) {
    .feature { min-height: min(46rem, 88svh); }
    .feature__inner { padding-block: var(--space-3xl); }
    .feature__copy { max-width: 36rem; }
  }
</style>
