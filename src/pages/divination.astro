---
/**
 * Divination: the world entered through the Divination door on the landing ("The Threshold").
 * Same night sky and eclipse, but calmer and built for reading. Static (no Square), no cart code.
 * ALL words come from ~/config/divination (confirmed content only). Works without JavaScript:
 * scroll reveals are an enhancement gated by `.js`, and everything is visible with motion off.
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import Eyebrow from '~/components/brand/Eyebrow.astro';
import Sky from '~/components/landing/Sky.astro';
import Eclipse from '~/components/landing/Eclipse.astro';
import { divination as d } from '~/config/divination';
import { card } from '~/config/card';
import { breadcrumbs } from '~/seo/jsonld';

// "Love Beyond the Veil." → accent the last word, keep the sentence intact.
const words = d.hero.headline.split(' ');
const accent = words.pop()!;
const lead = words.join(' ');
const pad = (n: number) => String(n).padStart(2, '0');
const mailto = card.email ? `mailto:${card.email}` : null;
---
<BaseLayout
  chrome="divination"
  title={d.title}
  description={d.description}
  path={d.path}
  jsonLd={breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Divination', path: d.path }], Astro.site)}
>
  <Sky />

  <!-- 1 · HERO ------------------------------------------------------------------------- -->
  <section class="hero container-wide" aria-labelledby="dv-title">
    <div class="hero__text">
      <div class="rise" style="--n:0"><Eyebrow>{d.hero.eyebrow}</Eyebrow></div>
      <h1 id="dv-title" class="hero__title rise" style="--n:1">{lead} <span class="text-pink">{accent}</span></h1>
      <p class="hero__support t-statement rise" style="--n:2">{d.hero.support}</p>
      <p class="hero__intro t-body rise" style="--n:3">{d.hero.intro}</p>
    </div>

    <div class="hero__art" aria-hidden="true">
      <svg class="hero__rings" viewBox="0 0 200 200" focusable="false">
        <circle cx="100" cy="100" r="97" fill="none" stroke="var(--rule)" stroke-width="1" vector-effect="non-scaling-stroke" />
        <circle class="hero__orbit" cx="100" cy="100" r="82" fill="none" stroke="var(--rule-strong)" stroke-width="1" stroke-dasharray="1.5 8" vector-effect="non-scaling-stroke" />
        <circle cx="100" cy="100" r="66" fill="none" stroke="var(--rule)" stroke-width="1" opacity="0.6" vector-effect="non-scaling-stroke" />
      </svg>
      <Eclipse />
      <span class="pendulum">
        <svg class="pendulum__bob" viewBox="0 0 12 24" focusable="false"><path d="M6 0C6 7 12 11 12 17a6 6 0 0 1-12 0C0 11 6 7 6 0Z" fill="var(--noir)" stroke="var(--warm-white)" stroke-width="1" vector-effect="non-scaling-stroke" /><path d="M6 13.5l1.2 2.3L6 18.1l-1.2-2.3Z" fill="var(--pink)" /></svg>
      </span>
    </div>
  </section>

  <!-- 2 · WHO I AM --------------------------------------------------------------------- -->
  <section class="band meet" aria-labelledby="meet-title">
    <div class="container-wide split">
      <div class="split__head" data-reveal>
        <span class="idx t-label" aria-hidden="true">{pad(1)}</span>
        <h2 id="meet-title" class="h-display">{d.meet.heading}</h2>
        <span class="star" aria-hidden="true"></span>
      </div>
      <div class="prose">
        {d.meet.paragraphs.map((p, i) => <p class:list={['prose__p', { 'prose__p--lead': i === 0 }]} data-reveal style={`--reveal-delay:${i * 0.08}s`}>{p}</p>)}
      </div>
    </div>
  </section>

  <!-- 3 · SERVICES --------------------------------------------------------------------- -->
  <section class="band services" aria-labelledby="services-title">
    <h2 id="services-title" class="visually-hidden">{d.servicesLabel}</h2>
    {d.services.map((s, i) => (
      <article class="container-wide split service" aria-labelledby={`svc-${s.key}`}>
        <div class="split__head" data-reveal>
          <span class="idx t-label" aria-hidden="true">{pad(i + 1)}</span>
          <h3 id={`svc-${s.key}`} class="h-display">{s.title}</h3>
          {s.key === 'lenormand' ? (
            <svg class="motif motif--card" viewBox="0 0 160 190" aria-hidden="true" focusable="false">
              <g transform="rotate(-7 80 95)"><rect x="30" y="16" width="92" height="144" rx="6" fill="none" stroke="var(--rule-strong)" stroke-width="1" opacity="0.55" vector-effect="non-scaling-stroke" /></g>
              <rect x="40" y="24" width="92" height="144" rx="6" fill="var(--noir)" fill-opacity="0.55" stroke="var(--rule-strong)" stroke-width="1" vector-effect="non-scaling-stroke" />
              <rect x="47" y="31" width="78" height="130" rx="3" fill="none" stroke="var(--rule)" stroke-width="1" vector-effect="non-scaling-stroke" />
              <path d="M86 31v62" stroke="var(--warm-white)" stroke-width="1" opacity="0.7" vector-effect="non-scaling-stroke" />
              <path class="motif__swing" d="M58 112Q86 132 114 112" fill="none" stroke="var(--rule-strong)" stroke-width="1" stroke-dasharray="2 5" vector-effect="non-scaling-stroke" />
              <path d="M86 93c0 4 5 7 5 11a5 5 0 0 1-10 0c0-4 5-7 5-11Z" fill="var(--noir)" stroke="var(--warm-white)" stroke-width="1" vector-effect="non-scaling-stroke" />
              <path d="M86 100l1 2-1 2-1-2Z" fill="var(--pink)" />
              <g fill="var(--pink)"><path d="M54 40l.9 2.4 2.4.9-2.4.9L54 46.6l-.9-2.4-2.4-.9 2.4-.9Z" /><path d="M118 152l.9 2.4 2.4.9-2.4.9-.9 2.4-.9-2.4-2.4-.9 2.4-.9Z" /></g>
            </svg>
          ) : (
            <svg class="motif motif--scribe" viewBox="0 0 220 110" aria-hidden="true" focusable="false">
              <g stroke="var(--rule)" stroke-width="1" opacity="0.7" vector-effect="non-scaling-stroke"><path d="M6 30H214" vector-effect="non-scaling-stroke" /><path d="M6 60H214" vector-effect="non-scaling-stroke" /><path d="M6 90H214" vector-effect="non-scaling-stroke" /></g>
              <path class="motif__line" pathLength="1" d="M6 66C24 66 28 22 46 24S62 62 80 60S100 16 122 28S138 68 160 56S188 20 206 36" fill="none" stroke="var(--warm-white)" stroke-width="1.25" stroke-linecap="round" vector-effect="non-scaling-stroke" />
              <path d="M206 24l2.2 7.4 7.4 2.2-7.4 2.2L206 43.2l-2.2-7.4-7.4-2.2 7.4-2.2Z" fill="var(--pink)" />
            </svg>
          )}
        </div>
        <div class="prose">
          {s.paragraphs.map((p, j) => <p class="prose__p" data-reveal style={`--reveal-delay:${j * 0.08}s`}>{p}</p>)}
        </div>
      </article>
    ))}
  </section>

  <!-- 4 · APPROACH --------------------------------------------------------------------- -->
  <section class="band approach" aria-labelledby="approach-title">
    <div class="container-wide approach__inner">
      <span class="idx t-label" aria-hidden="true" data-reveal>{pad(3)}</span>
      <h2 id="approach-title" class="h-display" data-reveal>{d.approach.heading}</h2>
      <p class="approach__lead" data-reveal>{d.approach.lead}</p>
      <p class="approach__closing t-statement" data-reveal>
        <span class="star star--center" aria-hidden="true"></span>
        {d.approach.closing}
      </p>
    </div>
  </section>

  <!-- 5 · ETHICS ----------------------------------------------------------------------- -->
  <section class="band ethics" aria-labelledby="ethics-title">
    <div class="container-wide">
      <header class="ethics__head" data-reveal>
        <p class="t-label ethics__eyebrow">{d.ethics.eyebrow}</p>
        <h2 id="ethics-title" class="h-display">{d.ethics.heading}</h2>
        <p class="ethics__intro">{d.ethics.intro}</p>
      </header>
      <div class="laws">
        {d.ethics.groups.map((g, i) => (
          <section class="law" aria-labelledby={`law-${i}`} data-reveal>
            <div class="law__head">
              <span class="idx t-label" aria-hidden="true">{pad(i + 1)}</span>
              <h3 id={`law-${i}`} class="law__title">{g.title}</h3>
            </div>
            <ul class="law__list list-reset" role="list">
              {g.items.map((it) => <li>{it}</li>)}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </section>

  <!-- 6 · CLOSING ---------------------------------------------------------------------- -->
  <section class="band closing">
    <div class="container-wide closing__inner" data-reveal>
      <svg class="closing__moon" viewBox="0 0 100 100" aria-hidden="true" focusable="false"><circle cx="50" cy="50" r="46" fill="none" stroke="var(--rule-strong)" stroke-width="1" vector-effect="non-scaling-stroke" /><path d="M58 22A30 30 0 1 0 58 78A34 34 0 0 1 58 22Z" fill="none" stroke="var(--warm-white)" stroke-width="1.25" stroke-linejoin="round" vector-effect="non-scaling-stroke" /></svg>
      <h2 id="closing-title" class="h-display closing__title">{d.closing.headline}</h2>
      <p class="t-statement closing__support">{d.closing.support}</p>
      <div class="closing__actions">
        {mailto && <a class="btn" href={mailto}>{d.closing.enquire} <span class="btn__arrow" aria-hidden="true">→</span></a>}
        <a class="link-arrow" href="/store">Visit the shop <span class="btn__arrow" aria-hidden="true">→</span></a>
      </div>
      {card.email && <p class="closing__mail t-label">{card.email}</p>}
    </div>
  </section>
</BaseLayout>

<style>
  /* The shared sky stays, but quieter: no light beam or meteor behind long reading. */
  :global(.sky__beam), :global(.meteor), :global(.glint) { display: none; }
  /* html already paints Noir; a transparent body lets the fixed sky (z-index -1) show through. */
  :global(body) { background: transparent; }

  /* Reading comfort: the same sky, with the stars turned down so they never compete with the type. */
  :global(.sky .stars.stars--far) { opacity: 0.28; }
  :global(.sky .stars.stars--mid) { opacity: 0.36; }
  :global(.sky .stars.stars--near) { --hi: 0.5; --lo: 0.25; }
  .h-display { font-family: var(--font-display); font-weight: 400; text-transform: uppercase; line-height: 0.92; letter-spacing: 0.005em; text-wrap: balance; font-size: clamp(2.75rem, 1.6rem + 5vw, 5rem); }
  .idx { display: block; color: var(--pink); }
  .star { display: block; width: 0.75rem; height: 0.75rem; background: var(--pink); clip-path: polygon(50% 0, 60% 40%, 100% 50%, 60% 60%, 50% 100%, 40% 60%, 0 50%, 40% 40%); }
  .band { position: relative; padding-block: var(--space-2xl); border-top: var(--border-thin); }

  /* ---- Hero ----------------------------------------------------------------------------- */
  .hero { display: grid; gap: var(--space-l); align-items: center; padding-block: var(--space-m) var(--space-2xl); }
  .hero__text { display: grid; gap: var(--space-m); justify-items: start; order: 2; }
  .hero__title { font-family: var(--font-display); font-weight: 400; text-transform: uppercase; line-height: 0.88; text-wrap: balance; font-size: clamp(3.75rem, 2rem + 11vw, 9rem); }
  .hero__support { max-width: 26rem; color: var(--warm-white); }
  .hero__intro { max-width: 34rem; color: var(--text-muted); }
  .hero__art { --e: 4.75rem; order: 1; position: relative; width: min(100%, 15rem); aspect-ratio: 1; justify-self: center; }
  .hero__rings { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .hero__art :global(.eclipse) { --e: 4.75rem; left: 50%; right: auto; top: 50%; translate: -50% -50%; }
  .pendulum { position: absolute; left: 50%; top: -1.5rem; height: calc(50% - var(--e) / 2 - 0.7rem); width: 1px; margin-left: -0.5px; transform-origin: 50% 0; background: linear-gradient(to bottom, transparent, color-mix(in srgb, var(--warm-white) 55%, transparent) 14%); transform: rotate(3deg); }
  .pendulum__bob { max-width: none; position: absolute; left: 50%; bottom: -1.9rem; width: 1rem; height: 2rem; margin-left: -0.5rem; overflow: visible; }

  @media (min-width: 64rem) {
    .hero { grid-template-columns: 7fr 5fr; gap: var(--space-2xl); min-height: calc(100svh - var(--header-h)); padding-block: var(--space-xl); }
    .hero__text { order: 1; }
    .hero__art { order: 2; width: min(100%, 26rem); --e: 7rem; }
    .hero__art :global(.eclipse) { --e: 7rem; }
  }

  /* ---- Two-column editorial rows -------------------------------------------------------- */
  .split { display: grid; gap: var(--space-l); }
  .split__head { display: grid; gap: var(--space-s); justify-items: start; align-content: start; }
  .prose { display: grid; align-content: start; gap: var(--space-m); max-width: 38rem; }
  .prose__p { font-size: var(--fs-body); line-height: 1.7; color: var(--text-muted); text-wrap: pretty; }
  .prose__p--lead { font-family: var(--font-statement); font-size: var(--fs-statement-sm); font-weight: 500; line-height: 1.4; color: var(--warm-white); }
  .service + .service { margin-top: var(--space-2xl); padding-top: var(--space-2xl); border-top: var(--border-thin); }
  .services { padding-block: var(--space-2xl); }

  .motif { width: min(60%, 10rem); height: auto; margin-top: var(--space-s); overflow: visible; }
  .motif--scribe { width: min(80%, 14rem); }
  .motif__line { stroke-dasharray: 1; stroke-dashoffset: 0; }

  @media (min-width: 48rem) {
    .split { grid-template-columns: 5fr 7fr; gap: var(--space-2xl); }
    .meet .split__head, .service .split__head { position: sticky; top: calc(var(--header-h) + var(--space-l)); align-self: start; }
  }

  /* ---- Approach ------------------------------------------------------------------------- */
  .approach__inner { display: grid; justify-items: center; text-align: center; gap: var(--space-m); max-width: 52rem; }
  .approach__lead { font-size: var(--fs-body); line-height: 1.75; color: var(--text-muted); max-width: 40rem; text-wrap: pretty; }
  .approach__closing { position: relative; margin-top: var(--space-m); padding-top: var(--space-l); max-width: 40rem; color: var(--warm-white); }
  .star--center { position: absolute; left: 50%; top: 0; translate: -50% -50%; }
  .approach__closing::before { content: ''; position: absolute; left: 50%; top: 0; width: min(100%, 14rem); height: 1px; translate: -50% 0; background: linear-gradient(90deg, transparent, var(--rule-strong), transparent); }

  /* ---- Ethics --------------------------------------------------------------------------- */
  .ethics__head { display: grid; gap: var(--space-s); justify-items: start; max-width: 44rem; margin-bottom: var(--space-xl); }
  .ethics__eyebrow { color: var(--pink); }
  .ethics__intro { font-size: var(--fs-body); line-height: 1.7; color: var(--text-muted); text-wrap: pretty; }
  .laws { display: grid; }
  .law { display: grid; gap: var(--space-s); padding-block: var(--space-l); border-top: var(--border-thin); }
  .law__head { display: grid; gap: 0.35rem; align-content: start; }
  .law__title { font-family: var(--font-display); font-weight: 400; text-transform: uppercase; line-height: 0.95; letter-spacing: 0.01em; font-size: clamp(2rem, 1.4rem + 2vw, 2.75rem); }
  .law__list { display: grid; gap: 0.85rem; max-width: 38rem; }
  .law__list li { position: relative; padding-left: 1.5rem; font-size: var(--fs-body); line-height: 1.65; color: var(--text-muted); text-wrap: pretty; }
  .law__list li::before { content: ''; position: absolute; left: 0; top: 0.55em; width: 0.55rem; height: 0.55rem; background: var(--pink); clip-path: polygon(50% 0, 60% 40%, 100% 50%, 60% 60%, 50% 100%, 40% 60%, 0 50%, 40% 40%); }
  @media (min-width: 48rem) {
    .law { grid-template-columns: 5fr 7fr; gap: var(--space-2xl); }
  }

  /* ---- Closing -------------------------------------------------------------------------- */
  .closing { padding-block: var(--space-3xl); }
  .closing__inner { display: grid; justify-items: center; text-align: center; gap: var(--space-m); }
  .closing__moon { width: 3.25rem; height: 3.25rem; overflow: visible; }
  .closing__title { font-size: clamp(3rem, 1.5rem + 7vw, 7rem); }
  .closing__support { max-width: 28rem; }
  .closing__actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: var(--space-s) var(--space-l); margin-top: var(--space-s); }
  .closing__mail { color: var(--text-muted); text-transform: none; letter-spacing: 0.04em; overflow-wrap: anywhere; }

  /* ---- Motion: restrained, and only when the visitor allows it -------------------------- */
  @media (prefers-reduced-motion: no-preference) {
    .rise { animation: rise 1s var(--ease-out) calc(0.15s + var(--n) * 0.12s) backwards; }
    .hero__art { animation: art-in 2s var(--ease-out) 0.2s backwards; }
    .pendulum { animation: swing 7s ease-in-out -2s infinite alternate; }
    .hero__orbit { transform-origin: 50% 50%; animation: turn 160s linear infinite; }
    .motif__swing { animation: fade 5s ease-in-out infinite alternate; }
    /* The scribing line writes itself as it scrolls into view (visible at once without JS). */
    :global(.js) .motif__line { stroke-dashoffset: 1; transition: stroke-dashoffset 2.4s var(--ease-in-out) 0.25s; }
    :global(.js) .is-in .motif__line { stroke-dashoffset: 0; }
    @keyframes rise { from { opacity: 0; transform: translate3d(0, 1rem, 0); } }
    @keyframes art-in { from { opacity: 0; } }
    @keyframes swing { from { transform: rotate(-7deg); } to { transform: rotate(7deg); } }
    @keyframes turn { to { transform: rotate(360deg); } }
    @keyframes fade { from { opacity: 0.35; } to { opacity: 1; } }
  }
</style>
