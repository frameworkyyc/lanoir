---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { commerce } from '~/lib/commerce';
import { settle } from '~/lib/catalog-result';
import { organization, website } from '~/seo/jsonld';
import { siteConfig } from '~/config/site';
import Hero from '~/components/sections/Hero.astro';
import SignatureCollections from '~/components/sections/SignatureCollections.astro';
import FeaturedProducts from '~/components/sections/FeaturedProducts.astro';
import BrandStatement from '~/components/sections/BrandStatement.astro';
import AfterDarkFeature from '~/components/sections/AfterDarkFeature.astro';
import StatementWearFeature from '~/components/sections/StatementWearFeature.astro';
import PrideFeature from '~/components/sections/PrideFeature.astro';
import AboutPreview from '~/components/sections/AboutPreview.astro';
import Community from '~/components/sections/Community.astro';
import CatalogNotice from '~/components/commerce/CatalogNotice.astro';

export const prerender = false; // product sections use live Square data

// Collections are editorial (no Square call). Products come from ONE catalogue snapshot.
const [prettyPoison, afterDark, mysticMinis, pride] = (await Promise.all(
  ['pretty-poison', 'after-dark', 'mystic-minis', 'pride-exclusive'].map((s) => commerce.getCollection(s)),
));
if (!prettyPoison || !afterDark || !mysticMinis || !pride) throw new Error('Editorial collections missing');

const catalog = await settle(commerce.getProducts());
const products = catalog.ok ? catalog.data : [];
if (!catalog.ok) Astro.response.headers.set('Cache-Control', 'no-store');

const inCollection = (slug: string, n: number) => products.filter((p) => p.collections.includes(slug)).slice(0, n);
const minis = inCollection('mystic-minis', 4);
const featured = products.filter((p) => p.featured).slice(0, 4); // controlled by the Square "Featured" category
const apparel = inCollection('statement-wear', 3);
const prideProducts = inCollection('pride-exclusive', 2);
const afterDarkProducts = inCollection('after-dark', 1);
---
<BaseLayout
  title={`${siteConfig.name} — ${siteConfig.descriptor} | Wear your power`}
  description={siteConfig.description}
  path="/"
  jsonLd={[organization(Astro.site), website(Astro.site)]}
>
  <Hero />
  <SignatureCollections {prettyPoison} {afterDark} {mysticMinis} {minis} />
  {!catalog.ok && <div class="container-wide"><CatalogNotice kind="error" /></div>}
  {featured.length > 0 && <FeaturedProducts products={featured} />}
  <BrandStatement />
  <AfterDarkFeature collection={afterDark} product={afterDarkProducts[0]} />
  {apparel.length > 0 && <StatementWearFeature products={apparel} />}
  <PrideFeature collection={pride} products={prideProducts} />
  <AboutPreview />
  <Community />
</BaseLayout>
