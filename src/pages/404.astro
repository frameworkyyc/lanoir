---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Eyebrow from '~/components/brand/Eyebrow.astro';
---
<BaseLayout title="Page not found" noindex>
  <section class="container-wide nf">
    <Eyebrow>404</Eyebrow>
    <h1 class="t-hero">Lost<br /><span class="text-pink">the plot.</span></h1>
    <a class="btn" href="/">Back home <span class="btn__arrow" aria-hidden="true">→</span></a>
  </section>
</BaseLayout>
<style>.nf { display: grid; gap: var(--space-m); justify-items: start; padding-block: var(--space-xl) 0; min-height: 60svh; align-content: center; }</style>
