---
import ListingPage from '~/components/commerce/ListingPage.astro';
import { commerce } from '~/lib/commerce';
import { markUnavailable, settle } from '~/lib/catalog-result';

export const prerender = false; // live Square data

const collection = (await commerce.getCollection('statement-wear'))!;
const result = await settle(commerce.getProducts({ collection: 'statement-wear' }));
if (!result.ok) markUnavailable(Astro);
---
<ListingPage title="Statement Wear" heading={['Statement', 'wear.']} eyebrow="Apparel" intro={collection.tagline} products={result.ok ? result.data : []} status={result.ok ? 'ok' : 'error'} path="/statement-wear" {collection} />
