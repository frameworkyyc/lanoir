---
/**
 * Product page. Live Square data (server-rendered on the Worker).
 * Handles: no images, no variations, size/colour options, sold-out, Square unavailable.
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import { commerce } from '~/lib/commerce';
import { markUnavailable, settle } from '~/lib/catalog-result';
import { collectionUrl } from '~/lib/routes';
import Picture from '~/components/media/Picture.astro';
import Eyebrow from '~/components/brand/Eyebrow.astro';
import AddToCart from '~/components/commerce/AddToCart.astro';
import CatalogNotice from '~/components/commerce/CatalogNotice.astro';
import ProductGrid from '~/components/commerce/ProductGrid.astro';
import { breadcrumbs, productLd } from '~/seo/jsonld';

export const prerender = false;

const slug = Astro.params.slug ?? '';
const result = await settle(commerce.getProduct(slug));
if (result.ok && !result.data) return new Response(null, { status: 404 }); // Astro renders src/pages/404.astro
if (!result.ok) markUnavailable(Astro);

const product = result.ok ? result.data! : undefined;
const collection = product?.collections[0] ? await commerce.getCollection(product.collections[0]) : undefined;
const relatedResult = product && collection
  ? await settle(commerce.getProducts({ collection: collection.slug, excludeSlug: product.slug, limit: 4 }))
  : undefined;
const related = relatedResult?.ok ? relatedResult.data : [];

const path = `/products/${slug}`;
const variant = (['pretty-poison', 'after-dark', 'mystic-minis'] as const).find((v) => v === collection?.slug) ?? (collection?.slug === 'pride-exclusive' ? 'pride' : 'neutral');
const images = product && product.images.length ? product.images : [undefined];
const paragraphs = (product?.description ?? '').split(/\n{2,}/).map((t) => t.trim()).filter(Boolean);
const ogImage = typeof product?.images[0]?.src === 'string' ? product.images[0].src : undefined;
---
<BaseLayout
  title={product?.name ?? 'Shop'}
  description={product ? (paragraphs[0]?.slice(0, 160) ?? `${product.name} from LaNoir — Bad Ass Witchery.`) : undefined}
  {path}
  ogType="product"
  image={ogImage}
  noindex={!product}
  jsonLd={product ? [productLd(product, path, Astro.site), breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Shop', path: '/shop' }, { name: product.name, path }], Astro.site)] : undefined}
>
  {!product ? (
    <div class="container-wide"><CatalogNotice kind="error" /></div>
  ) : (
    <>
    <article class="container-wide pdp">
      <ul class="pdp__gallery list-reset" role="list" aria-label={`${product.name} photos`}>
        {images.map((media, i) => (
          <li class="pdp__shot">
            <Picture {media} ratio="4/5" {variant} eager={i === 0} reveal={i > 0}
              label={`${product.name} — product photograph ${i + 1}`}
              sizes="(min-width: 64rem) 34vw, 88vw" />
          </li>
        ))}
      </ul>

      <div class="pdp__info">
        {collection && <Eyebrow><a href={collectionUrl(collection)}>{collection.name}</a></Eyebrow>}
        <h1 class="t-display pdp__title">{product.name}</h1>

        <AddToCart {product} />

        {paragraphs.length > 0 && (
          <div class="pdp__desc">
            <h2 class="t-label">Details</h2>
            {paragraphs.map((t) => <p class="t-body t-muted">{t}</p>)}
          </div>
        )}
        {product.details?.length ? (
          <dl class="pdp__specs">
            {product.details.map((d) => <><dt class="t-label">{d.label}</dt><dd>{d.value}</dd></>)}
          </dl>
        ) : null}

        <p class="pdp__links t-label">
          {collection && <a href={collectionUrl(collection)}>More from {collection.name} →</a>}
          <a href="/policies/shipping">Shipping information →</a>
        </p>
      </div>
    </article>

    {related.length > 0 && (
      <section class="container-wide pdp__related" aria-labelledby="related-title">
        <h2 id="related-title" class="t-display-sm">You might also <span class="text-pink">want.</span></h2>
        <ProductGrid products={related} {variant} cols={4} />
      </section>
    )}
    </>
  )}
</BaseLayout>

<style>
  .pdp { display: grid; gap: var(--space-l); padding-block: var(--space-m) 0; }

  /* Mobile: swipeable photo strip. */
  .pdp__gallery {
    display: grid; grid-auto-flow: column; grid-auto-columns: 88%;
    gap: var(--space-2xs);
    margin-inline: calc(var(--gutter) * -1); padding-inline: var(--gutter);
    overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--gutter); scrollbar-width: none;
  }
  .pdp__gallery::-webkit-scrollbar { display: none; }
  .pdp__shot { scroll-snap-align: start; }
  .pdp__gallery:has(.pdp__shot:only-child) { grid-auto-columns: 100%; }

  .pdp__info { display: grid; gap: var(--space-m); justify-items: start; align-content: start; min-width: 0; }
  .pdp__title { overflow-wrap: anywhere; }
  .pdp__desc { display: grid; gap: var(--space-xs); padding-top: var(--space-m); border-top: var(--border-thin); width: 100%; }
  .pdp__desc h2 { color: var(--pink); }
  .pdp__desc p { white-space: pre-line; }
  .pdp__specs { display: grid; grid-template-columns: auto 1fr; gap: var(--space-2xs) var(--space-m); width: 100%; margin: 0; }
  .pdp__specs dt { color: var(--text-muted); } .pdp__specs dd { margin: 0; }
  .pdp__links { display: grid; gap: 0; color: var(--text-muted); }
  .pdp__links a { display: inline-flex; align-items: center; min-height: 2.75rem; transition: color var(--dur-base); }
  .pdp__links a:hover { color: var(--pink); }
  .pdp__related { display: grid; gap: var(--space-l); padding-top: var(--space-2xl); }

  @media (min-width: 64rem) {
    .pdp { grid-template-columns: 7fr 5fr; gap: var(--space-2xl); padding-block: var(--space-xl) 0; align-items: start; }
    /* Desktop: editorial photo grid — first photo full width, the rest two-up. */
    .pdp__gallery { display: grid; grid-auto-flow: row; grid-template-columns: 1fr 1fr; grid-auto-columns: auto; margin: 0; padding: 0; overflow: visible; gap: var(--space-xs); }
    .pdp__gallery:has(.pdp__shot:only-child) { grid-template-columns: 1fr; }
    .pdp__shot:first-child { grid-column: 1 / -1; }
    .pdp__info { position: sticky; top: calc(var(--header-h) + var(--space-l)); }
  }
</style>
