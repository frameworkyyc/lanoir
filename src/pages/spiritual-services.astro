  .zone { --dome: clamp(1.75rem, 5vw, 4.5rem); --zpad: clamp(2.75rem, 5vw, 4.5rem); position: relative; isolation: isolate; overflow-x: clip; padding-block: var(--zpad) calc(var(--zpad) + var(--dome)); background: linear-gradient(to bottom, var(--zone-top), var(--zone-bot)); }
