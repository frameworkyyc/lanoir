---
/**
 * Spiritual Services: the world entered through the Spiritual Services door on the landing ("The Threshold").
 * Same night sky and eclipse, but calmer and built for reading. Static (no Square), no cart code.
 * ALL words come from ~/config/spiritual-services (confirmed content only). Works without JavaScript:
 * scroll reveals are an enhancement gated by `.js`, and everything is visible with motion off.
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import Eyebrow from '~/components/brand/Eyebrow.astro';
import Sky from '~/components/landing/Sky.astro';
import Eclipse from '~/components/landing/Eclipse.astro';
import { spiritualServices as d, meetPullQuote } from '~/config/spiritual-services';
import { card } from '~/config/card';
import { breadcrumbs } from '~/seo/jsonld';

// "Love Beyond the Veil." → accent the last word, keep the sentence intact.
const words = d.hero.headline.split(' ');
const accent = words.pop()!;
const lead = words.join(' ');
const pad = (n: number) => String(n).padStart(2, '0');
const mailto = card.email ? `mailto:${card.email}` : null;

// One small line symbol per ethics principle (same order as the config). Decorative.
const symbols = ['plumb', 'fork', 'cradle', 'veil', 'gate'] as const;
---
<BaseLayout
  chrome="spiritual"
  title={d.title}
  description={d.description}
  path={d.path}
  jsonLd={breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Spiritual Services', path: d.path }], Astro.site)}
>
  <Sky />

  <!-- 1 · HERO ------------------------------------------------------------------------- -->
  <section class="hero container-wide" aria-labelledby="dv-title">
    <div class="hero__text">
      <div class="rise" style="--n:0"><Eyebrow>{d.hero.eyebrow}</Eyebrow></div>
      <h1 id="dv-title" class="hero__title rise" style="--n:1">{lead} <span class="text-pink">{accent}</span></h1>
      <p class="hero__support t-statement rise" style="--n:2">{d.hero.support}</p>
      <p class="hero__intro t-body rise" style="--n:3">{d.hero.intro}</p>
    </div>

    <div class="hero__art" aria-hidden="true">
      <svg class="hero__rings" viewBox="0 0 200 200" focusable="false">
        <circle cx="100" cy="100" r="97" fill="none" stroke="var(--rule)" stroke-width="1" vector-effect="non-scaling-stroke" />
        <circle class="hero__orbit" cx="100" cy="100" r="82" fill="none" stroke="var(--rule-strong)" stroke-width="1" stroke-dasharray="1.5 8" vector-effect="non-scaling-stroke" />
        <circle cx="100" cy="100" r="66" fill="none" stroke="var(--rule)" stroke-width="1" opacity="0.6" vector-effect="non-scaling-stroke" />
      </svg>
      <Eclipse />
      <span class="pendulum">
        <svg class="pendulum__bob" viewBox="0 0 12 24" focusable="false"><path d="M6 0C6 7 12 11 12 17a6 6 0 0 1-12 0C0 11 6 7 6 0Z" fill="var(--noir)" stroke="var(--warm-white)" stroke-width="1" vector-effect="non-scaling-stroke" /><path d="M6 13.5l1.2 2.3L6 18.1l-1.2-2.3Z" fill="var(--pink)" /></svg>
      </span>
    </div>
  </section>


  <!-- 2 · WHO I AM : deep plum ----------------------------------------------------------- -->
  <section class="zone zone--plum meet" aria-labelledby="meet-title">
    <div class="container-wide meet__grid">
      <div class="meet__side">
        <div class="meet__head" data-reveal>
          <span class="idx t-label" aria-hidden="true">{pad(1)}</span>
          <h2 id="meet-title" class="h-display">{d.meet.heading}</h2>
        </div>

        <!-- Original line art: a Lenormand card, a dowsing pendulum and a scribed line. -->
        <div class="meet__art" aria-hidden="true" data-reveal>
          <div class="layer par" style="--py:1.25rem">
            <svg viewBox="0 0 400 460" focusable="false">
              <circle cx="200" cy="230" r="190" fill="none" stroke="var(--rule)" stroke-width="1" stroke-dasharray="1 8" vector-effect="non-scaling-stroke" />
              <circle cx="200" cy="230" r="148" fill="none" stroke="var(--pink)" stroke-width="1" opacity="0.22" vector-effect="non-scaling-stroke" />
              <g fill="var(--warm-white)"><path class="tw" d="M58 78l2 7 7 2-7 2-2 7-2-7-7-2 7-2Z" /><path class="tw tw--b" d="M352 132l1.6 5.4 5.4 1.6-5.4 1.6-1.6 5.4-1.6-5.4-5.4-1.6 5.4-1.6Z" /><path class="tw tw--c" d="M36 346l1.4 4.6 4.6 1.4-4.6 1.4-1.4 4.6-1.4-4.6-4.6-1.4 4.6-1.4Z" /></g>
            </svg>
          </div>
          <div class="layer par" style="--py:-0.5rem">
            <svg viewBox="0 0 400 460" focusable="false">
              <defs>
                <linearGradient id="mcard" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="var(--pink)" stop-opacity="0.28" /><stop offset="1" stop-color="var(--noir)" stop-opacity="0.6" /></linearGradient>
              </defs>
              <g transform="rotate(-9 200 190)"><rect x="115" y="58" width="170" height="262" rx="12" fill="none" stroke="var(--warm-white)" stroke-opacity="0.28" stroke-width="1" vector-effect="non-scaling-stroke" /></g>
              <g transform="rotate(7 200 190)"><rect x="115" y="58" width="170" height="262" rx="12" fill="none" stroke="var(--warm-white)" stroke-opacity="0.2" stroke-width="1" vector-effect="non-scaling-stroke" /></g>
              <rect x="115" y="58" width="170" height="262" rx="12" fill="url(#mcard)" stroke="var(--warm-white)" stroke-opacity="0.8" stroke-width="1.25" vector-effect="non-scaling-stroke" />
              <rect class="frame" x="127" y="70" width="146" height="238" rx="6" fill="none" stroke="var(--pink)" stroke-opacity="0.7" stroke-width="1" stroke-dasharray="3 7" vector-effect="non-scaling-stroke" />
              <circle cx="200" cy="170" r="38" fill="none" stroke="var(--warm-white)" stroke-opacity="0.7" stroke-width="1" vector-effect="non-scaling-stroke" />
              <path d="M209 146A24 24 0 1 0 209 194A27 27 0 0 1 209 146Z" fill="var(--warm-white)" fill-opacity="0.9" />
              <path d="M150 246H250M200 240l4 6-4 6-4-6Z" fill="none" stroke="var(--warm-white)" stroke-opacity="0.6" stroke-width="1" vector-effect="non-scaling-stroke" />
              <g fill="var(--pink)"><path d="M140 90l1.6 5.4 5.4 1.6-5.4 1.6-1.6 5.4-1.6-5.4-5.4-1.6 5.4-1.6Z" /><path d="M260 290l1.6 5.4 5.4 1.6-5.4 1.6-1.6 5.4-1.6-5.4-5.4-1.6 5.4-1.6Z" /></g>
              <path d="M255 296A300 300 0 0 0 405 296" fill="none" stroke="var(--warm-white)" stroke-opacity="0.35" stroke-width="1" stroke-dasharray="2 6" vector-effect="non-scaling-stroke" />
              <g class="pend">
                <path d="M330 6V300" stroke="var(--warm-white)" stroke-opacity="0.75" stroke-width="1" vector-effect="non-scaling-stroke" />
                <path d="M330 300c0 8 9 14 9 22a9 9 0 0 1-18 0c0-8 9-14 9-22Z" fill="var(--noir)" stroke="var(--warm-white)" stroke-width="1.25" vector-effect="non-scaling-stroke" />
                <path d="M330 311l2 4-2 4-2-4Z" fill="var(--pink)" />
              </g>
              <g class="draw-set">
                <path class="draw" pathLength="1" d="M20 418C60 380 92 458 132 418S200 380 238 422 300 460 340 408 372 384 384 400" fill="none" stroke="var(--warm-white)" stroke-width="1.25" stroke-linecap="round" vector-effect="non-scaling-stroke" />
                <path class="draw draw--b" pathLength="1" d="M40 436C80 410 110 462 150 436S214 410 250 440 316 462 352 428" fill="none" stroke="var(--warm-white)" stroke-opacity="0.4" stroke-width="1" stroke-linecap="round" vector-effect="non-scaling-stroke" />
              </g>
              <path d="M384 388l2.2 7.4 7.4 2.2-7.4 2.2-2.2 7.4-2.2-7.4-7.4-2.2 7.4-2.2Z" fill="var(--pink)" />
            </svg>
          </div>
        </div>

      </div>

      <div class="meet__copy">
        {d.meet.paragraphs.map((p, i) => <p class:list={['meet__p', { 'meet__p--lead': i === 0 }]} data-reveal style={`--reveal-delay:${i * 0.08}s`}>{p}</p>)}
      </div>
        <p class="pull" aria-hidden="true" data-reveal><span class="pull__mark">“</span>{meetPullQuote}</p>
    </div>
  </section>

  <!-- 2b · TRAINING & CERTIFICATIONS : a constellation timeline (credentials only: not bookable services) -->
  <section class="zone zone--night training" aria-labelledby="training-title">
    <div class="container-wide">
      <header class="training__head" data-reveal>
        <span class="star star--lg" aria-hidden="true"></span>
        <h2 id="training-title" class="h-display">{d.training.heading}</h2>
      </header>
      <ol class="cons list-reset" role="list">
        {d.training.items.map((it, i, all) => (
          <li class:list={['cons__item', i % 2 ? 'cons__item--r' : 'cons__item--l', { 'is-pending': !!it.status }]} data-reveal style={`--reveal-delay:${(i % 2) * 0.08}s`}>
            <span class="cons__node" aria-hidden="true">
              <svg viewBox="-16 -16 32 32" focusable="false">
                {it.status && <circle class="cons__ring" r="13" fill="none" stroke="var(--pink)" stroke-width="1" stroke-dasharray="2 4" vector-effect="non-scaling-stroke" />}
                <path class="cons__star" d="M0-11 2.6-2.6 11 0 2.6 2.6 0 11-2.6 2.6-11 0-2.6-2.6Z" />
              </svg>
            </span>
            {i < all.length - 1 && (
              <svg class:list={['cons__link', { 'cons__link--pending': !!all[i + 1].status }]} viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                <path class="draw" pathLength="1" d={i % 2 ? 'M100 0C100 55 0 45 0 100' : 'M0 0C0 55 100 45 100 100'} fill="none" vector-effect="non-scaling-stroke" />
              </svg>
            )}
            <div class="cons__text">
              <p class="cons__title">{it.title}</p>
              {it.detail && <p class="cons__detail">— {it.detail}</p>}
              {it.status && <p class="cons__status t-label"><span class="cons__pulse" aria-hidden="true"></span>{it.status}</p>}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 3 · SERVICES : two distinct worlds ------------------------------------------------- -->
  <section class="zone zone--stage services" aria-labelledby="services-title">
    <h2 id="services-title" class="visually-hidden">{d.servicesLabel}</h2>
    <div class="container-wide services__stack">
      {d.services.map((s, i) => (
        <article class={`feature feature--${s.key}`} aria-labelledby={`svc-${s.key}`}>
          <div class="feature__text" data-reveal>
            <span class="idx idx--soft t-label" aria-hidden="true">{pad(i + 1)}</span>
            <h3 id={`svc-${s.key}`} class="h-display">{s.title}</h3>
            <div class="feature__copy">{s.paragraphs.map((p) => <p>{p}</p>)}</div>
          </div>

          {s.key === 'lenormand' ? (
            <div class="feature__art art--len" aria-hidden="true" data-reveal style="--reveal-delay:0.12s">
              <div class="layer par" style="--py:1.5rem">
                <svg viewBox="0 0 480 440" focusable="false">
                  <circle cx="240" cy="250" r="206" fill="none" stroke="var(--pink)" stroke-opacity="0.2" stroke-width="1" vector-effect="non-scaling-stroke" />
                  <circle cx="240" cy="250" r="160" fill="none" stroke="var(--warm-white)" stroke-opacity="0.14" stroke-width="1" stroke-dasharray="1 8" vector-effect="non-scaling-stroke" />
                </svg>
              </div>
              <div class="layer par" style="--py:0.25rem">
                <svg viewBox="0 0 480 440" focusable="false">
                  <defs>
                    <linearGradient id="lc1" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="var(--pink)" stop-opacity="0.42" /><stop offset="1" stop-color="var(--noir)" stop-opacity="0.55" /></linearGradient>
                    <linearGradient id="lc2" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="var(--warm-white)" stop-opacity="0.18" /><stop offset="1" stop-color="var(--pink)" stop-opacity="0.12" /></linearGradient>
                  </defs>
                  <g transform="rotate(-17 240 400)"><rect x="165" y="118" width="150" height="240" rx="10" fill="url(#lc2)" stroke="var(--warm-white)" stroke-opacity="0.4" stroke-width="1" vector-effect="non-scaling-stroke" /></g>
                  <g transform="rotate(-4 240 400)"><rect x="165" y="118" width="150" height="240" rx="10" fill="url(#lc1)" stroke="var(--pink)" stroke-opacity="0.7" stroke-width="1" vector-effect="non-scaling-stroke" /></g>
                  <g transform="rotate(10 240 400)">
                    <rect x="165" y="118" width="150" height="240" rx="10" fill="var(--noir)" fill-opacity="0.6" stroke="var(--warm-white)" stroke-opacity="0.85" stroke-width="1.25" vector-effect="non-scaling-stroke" />
                    <rect x="175" y="128" width="130" height="220" rx="5" fill="none" stroke="var(--pink)" stroke-opacity="0.6" stroke-width="1" vector-effect="non-scaling-stroke" />
                    <path d="M240 150V232" stroke="var(--warm-white)" stroke-opacity="0.8" stroke-width="1" vector-effect="non-scaling-stroke" />
                    <path d="M240 232c0 6 7 11 7 17a7 7 0 0 1-14 0c0-6 7-11 7-17Z" fill="var(--noir)" stroke="var(--warm-white)" stroke-width="1.25" vector-effect="non-scaling-stroke" />
                    <path d="M200 296Q240 322 280 296" fill="none" stroke="var(--pink)" stroke-opacity="0.7" stroke-width="1" stroke-dasharray="2 5" vector-effect="non-scaling-stroke" />
                  </g>
                </svg>
              </div>
              <div class="layer par" style="--py:-1.25rem">
                <svg viewBox="0 0 480 440" focusable="false">
                  <path d="M40 330A230 230 0 0 1 440 330" fill="none" stroke="var(--pink)" stroke-opacity="0.75" stroke-width="1.25" vector-effect="non-scaling-stroke" />
                  <path d="M80 330A190 190 0 0 1 400 330" fill="none" stroke="var(--warm-white)" stroke-opacity="0.3" stroke-width="1" stroke-dasharray="2 7" vector-effect="non-scaling-stroke" />
                  <circle class="arc-glow" r="16" fill="var(--pink)" fill-opacity="0.28" style="offset-path:path('M40 330A230 230 0 0 1 440 330')" />
                  <circle class="arc-bob" r="6.5" fill="var(--pink)" style="offset-path:path('M40 330A230 230 0 0 1 440 330')" />
                  <g fill="var(--warm-white)"><circle cx="40" cy="330" r="2.5" /><circle cx="440" cy="330" r="2.5" /></g>
                </svg>
              </div>
              {s.timeline && (
                <ol class="timeline list-reset" role="list">
                  <li class="timeline__node timeline__node--now"><span class="timeline__dot"></span></li>
                  <li class="timeline__node timeline__node--near"><span class="timeline__dot"></span><span class="timeline__label t-label">{s.timeline[0]}</span></li>
                  <li class="timeline__node timeline__node--far"><span class="timeline__dot"></span><span class="timeline__label t-label">{s.timeline[1]}</span></li>
                </ol>
              )}
            </div>
          ) : (
            <div class="feature__art art--med" aria-hidden="true" data-reveal style="--reveal-delay:0.12s">
              <div class="layer par" style="--py:1.5rem">
                <svg viewBox="0 0 480 440" focusable="false">
                  <defs><radialGradient id="mglow"><stop offset="0" stop-color="var(--warm-white)" stop-opacity="0.34" /><stop offset="1" stop-color="var(--warm-white)" stop-opacity="0" /></radialGradient></defs>
                  <circle class="moon-glow" cx="330" cy="120" r="150" fill="url(#mglow)" />
                  <path d="M352 52A72 72 0 1 0 352 196A82 82 0 0 1 352 52Z" fill="var(--warm-white)" fill-opacity="0.94" />
                  <g fill="var(--warm-white)"><path class="tw" d="M96 70l2 7 7 2-7 2-2 7-2-7-7-2 7-2Z" /><path class="tw tw--b" d="M436 232l1.6 5.4 5.4 1.6-5.4 1.6-1.6 5.4-1.6-5.4-5.4-1.6 5.4-1.6Z" /><path class="tw tw--c" d="M150 168l1.4 4.6 4.6 1.4-4.6 1.4-1.4 4.6-1.4-4.6-4.6-1.4 4.6-1.4Z" /></g>
                </svg>
              </div>
              <div class="layer par" style="--py:0.5rem"><svg class="veil veil--a" viewBox="0 0 480 440" focusable="false"><defs><linearGradient id="vfade" gradientUnits="userSpaceOnUse" x1="-500" y1="0" x2="470" y2="0"><stop offset="0" stop-color="#fff" /><stop offset="0.66" stop-color="#fff" /><stop offset="1" stop-color="#000" /></linearGradient><mask id="vmask" maskUnits="userSpaceOnUse" x="-520" y="-20" width="1100" height="480"><rect x="-520" y="-20" width="1100" height="480" fill="url(#vfade)" /></mask><linearGradient id="v1" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="var(--warm-white)" stop-opacity="0.13" /><stop offset="1" stop-color="var(--warm-white)" stop-opacity="0" /></linearGradient></defs><path d="M-500 128C-300 68 -100 178 90 118S300 68 520 128V440H-500Z" fill="url(#v1)" mask="url(#vmask)" /><path d="M-500 128C-300 68 -100 178 90 118S300 68 520 128" fill="none" stroke="var(--warm-white)" stroke-opacity="0.45" stroke-width="1" vector-effect="non-scaling-stroke" mask="url(#vmask)" /></svg></div>
              <div class="layer par" style="--py:-0.75rem"><svg class="veil veil--b" viewBox="0 0 480 440" focusable="false"><defs><linearGradient id="v2" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="var(--gunmetal)" stop-opacity="0.3" /><stop offset="1" stop-color="var(--gunmetal)" stop-opacity="0" /></linearGradient></defs><path d="M-500 216C-300 166 -100 276 130 206S330 156 540 216V440H-500Z" fill="url(#v2)" mask="url(#vmask)" /><path d="M-500 216C-300 166 -100 276 130 206S330 156 540 216" fill="none" stroke="var(--warm-white)" stroke-opacity="0.3" stroke-width="1" vector-effect="non-scaling-stroke" mask="url(#vmask)" /></svg></div>
              <div class="layer par" style="--py:-1.5rem"><svg class="veil veil--c" viewBox="0 0 480 440" focusable="false"><defs><linearGradient id="v3" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="var(--warm-white)" stop-opacity="0.08" /><stop offset="1" stop-color="var(--warm-white)" stop-opacity="0" /></linearGradient></defs><path d="M-500 296C-300 246 -100 356 160 288S360 246 560 296V440H-500Z" fill="url(#v3)" mask="url(#vmask)" /></svg></div>
              <div class="layer par" style="--py:-2.25rem">
                <svg viewBox="0 0 480 440" focusable="false">
                  <g fill="none" stroke-linecap="round" vector-effect="non-scaling-stroke">
                    <path class="strand" pathLength="1" d="M40 336C90 296 120 376 170 336S250 296 290 341 360 386 440 326" stroke="var(--warm-white)" stroke-width="1.5" vector-effect="non-scaling-stroke" />
                    <path class="strand strand--b" pathLength="1" d="M60 372C110 342 140 402 190 369S270 337 310 375 380 407 430 359" stroke="var(--warm-white)" stroke-opacity="0.5" stroke-width="1" vector-effect="non-scaling-stroke" />
                    <path class="strand strand--c" pathLength="1" d="M90 300C140 270 170 330 220 300S300 275 340 305" stroke="var(--pink)" stroke-width="1.25" vector-effect="non-scaling-stroke" />
                  </g>
                  <path d="M440 316l2.4 8 8 2.4-8 2.4-2.4 8-2.4-8-8-2.4 8-2.4Z" fill="var(--pink)" />
                </svg>
              </div>
            </div>
          )}
        </article>
      ))}
    </div>
  </section>

  <!-- 4 · APPROACH : the pause (smoky plum) ----------------------------------------------- -->
  <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
    <defs>
      <symbol id="celestial" viewBox="0 0 200 200">
        <circle class="cel__ring" cx="100" cy="100" r="96" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="1.5 7" vector-effect="non-scaling-stroke" />
        <circle cx="100" cy="100" r="80" fill="none" stroke="currentColor" stroke-width="1" opacity="0.7" vector-effect="non-scaling-stroke" />
        <circle cx="100" cy="100" r="58" fill="var(--noir)" fill-opacity="0.55" stroke="currentColor" stroke-width="1.25" vector-effect="non-scaling-stroke" />
        <path d="M110 66A36 36 0 1 0 110 134A41 41 0 0 1 110 66Z" fill="currentColor" />
        <path d="M100 0v10M100 190v10M0 100h10M190 100h10" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke" />
        <path d="M148 52l2 6 6 2-6 2-2 6-2-6-6-2 6-2Z" fill="var(--pink)" />
      </symbol>
    </defs>
  </svg>
  <section class="zone zone--smoke approach" aria-labelledby="approach-title">
    <span class="approach__q approach__q--open" aria-hidden="true">“</span>
    <span class="approach__q approach__q--close" aria-hidden="true">”</span>
    <div class="container-wide approach__inner">
      <div class="approach__symbol par" style="--py:1.5rem" aria-hidden="true" data-reveal><svg viewBox="0 0 200 200" focusable="false"><use href="#celestial" /></svg></div>
      <span class="idx idx--soft t-label" aria-hidden="true" data-reveal>{pad(3)}</span>
      <h2 id="approach-title" class="h-display" data-reveal>{d.approach.heading}</h2>
      <p class="approach__lead" data-reveal>{d.approach.lead}</p>
      <p class="approach__closing" data-reveal>{d.approach.closing}</p>
    </div>
  </section>

  <!-- 5 · ETHICS : moonlit charcoal, five principle panels ---------------------------------- -->
  <section class="zone zone--charcoal ethics" aria-labelledby="ethics-title">
    <div class="container-wide">
      <header class="ethics__head" data-reveal>
        <p class="t-label ethics__eyebrow">{d.ethics.eyebrow}</p>
        <h2 id="ethics-title" class="h-display">{d.ethics.heading}</h2>
        <p class="ethics__intro">{d.ethics.intro}</p>
      </header>
      <div class="laws">
        {d.ethics.groups.map((g, i) => (
          <section class={`law law--${i + 1}`} aria-labelledby={`law-${i}`} data-reveal style={`--reveal-delay:${(i % 2) * 0.1}s`}>
            <svg class="law__sym" viewBox="0 0 48 48" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke">
              {symbols[i] === 'plumb' && (<><path d="M14 6H34M24 6V30" /><path d="M24 30c0 4 5 7 5 11a5 5 0 0 1-10 0c0-4 5-7 5-11Z" /><path d="M24 36l1.2 2.4L24 40.8l-1.2-2.4Z" fill="var(--pink)" stroke="none" /></>)}
              {symbols[i] === 'fork' && (<><circle cx="24" cy="40" r="2.5" /><path d="M24 37.5V24C24 16 14 14 11 8M24 24c0-8 10-10 13-16" /><path d="M7 11l4-3.5 3.2 4M33.5 11.5 37 8l4 3.2" /></>)}
              {symbols[i] === 'cradle' && (<><path d="M6 24a18 18 0 0 0 36 0" /><path d="M12 24a12 12 0 0 0 24 0" opacity="0.6" /><path d="M24 8l1.8 5.4L31 15l-5.2 1.6L24 22l-1.8-5.4L17 15l5.2-1.6Z" fill="var(--pink)" stroke="none" /></>)}
              {symbols[i] === 'veil' && (<><circle cx="19" cy="24" r="12" /><circle cx="29" cy="24" r="12" /><circle cx="24" cy="24" r="1.8" fill="var(--pink)" stroke="none" /></>)}
