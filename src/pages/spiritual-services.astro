  .zone--night { --zone-top: color-mix(in srgb, var(--gunmetal) 13%, var(--noir-deep)); --zone-bot: color-mix(in srgb, var(--pink) 5%, var(--noir-deep)); --edge: color-mix(in srgb, var(--warm-white) 24%, transparent); background:
      radial-gradient(1px 1px at 7% 18%, rgba(255,255,255,0.6) 99%, transparent), radial-gradient(1.4px 1.4px at 16% 70%, rgba(255,255,255,0.6) 99%, transparent), radial-gradient(1px 1px at 29% 38%, rgba(255,255,255,0.6) 99%, transparent),
      radial-gradient(1.2px 1.2px at 71% 14%, rgba(255,255,255,0.6) 99%, transparent), radial-gradient(1px 1px at 83% 52%, rgba(255,255,255,0.6) 99%, transparent), radial-gradient(1.5px 1.5px at 93% 80%, rgba(255,255,255,0.6) 99%, transparent), radial-gradient(1px 1px at 44% 90%, rgba(255,255,255,0.6) 99%, transparent),
