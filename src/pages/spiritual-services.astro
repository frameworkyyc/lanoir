  .zone--charcoal { --zone-top: color-mix(in srgb, var(--warm-white) 8%, color-mix(in srgb, var(--gunmetal) 21%, var(--noir))); --zone-bot: color-mix(in srgb, var(--gunmetal) 8%, var(--noir-deep)); --edge: color-mix(in srgb, var(--warm-white) 30%, transparent); }
