---
import ListingPage from '~/components/commerce/ListingPage.astro';
import { commerce } from '~/lib/commerce';
import { markUnavailable, settle } from '~/lib/catalog-result';

export const prerender = false; // live Square data

// Collections are editorial (known at build time); only their products are live.
const collection = await commerce.getCollection(Astro.params.slug ?? '');
if (!collection || collection.kind === 'category') return new Response(null, { status: 404 }); // Astro renders src/pages/404.astro

const result = await settle(commerce.getProducts({ collection: collection.slug }));
if (!result.ok) markUnavailable(Astro);

const heading = collection.name.split(' ') as [string, string?];
const variant = (['pretty-poison', 'after-dark', 'mystic-minis'] as const).find((v) => v === collection.slug) ?? (collection.slug === 'pride-exclusive' ? 'pride' : 'neutral');
---
<ListingPage
  title={collection.name}
  heading={[heading[0], heading.slice(1).join(' ') || undefined]}
  eyebrow={collection.kind === 'signature' ? `0${collection.order} / Signature collection` : 'Exclusive'}
  intro={`${collection.tagline} ${collection.description}`}
  products={result.ok ? result.data : []}
  status={result.ok ? 'ok' : 'error'}
  path={`/collections/${collection.slug}`}
  {collection}
  {variant}
/>
