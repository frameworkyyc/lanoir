---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Eyebrow from '~/components/brand/Eyebrow.astro';
// Static page. Square's hosted checkout redirects here after payment, appending
// ?checkoutId=…&orderId=…&transactionId=… . We only clear the cart when those are present.
---
<BaseLayout title="Order complete" path="/order-complete" noindex>
  <section class="container-wide done">
    <div class="done__yes" data-done hidden>
      <Eyebrow>Order placed</Eyebrow>
      <h1 class="t-display-xl">Thank<br /><span class="text-pink">you.</span></h1>
      <p class="t-statement-sm">Your payment went through on Square.</p>
      <a class="btn" href="/collections">Keep exploring <span class="btn__arrow" aria-hidden="true">→</span></a>
    </div>
    <div class="done__no" data-not-done>
      <Eyebrow>Order</Eyebrow>
      <h1 class="t-display-xl">Nothing<br /><span class="text-pink">to see.</span></h1>
      <p class="t-body t-muted">There's no completed order on this page.</p>
      <a class="btn" href="/shop">Shop all <span class="btn__arrow" aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>
<style>
  .done { padding-block: var(--space-xl) 0; }
  .done__yes, .done__no { display: grid; gap: var(--space-m); justify-items: start; }
  [hidden] { display: none !important; }
</style>
<script>
  import { cart } from '~/scripts/cart';
  const p = new URLSearchParams(location.search);
  if (p.get('orderId') || p.get('transactionId')) {
    cart.clear();
    document.querySelector('[data-done]')?.removeAttribute('hidden');
    document.querySelector('[data-not-done]')?.setAttribute('hidden', '');
  }
</script>
