---
/**
 * Digital business card. Everything shown here comes from ~/config/card (the single source),
 * so the page, the saved contact, the QR code and the link preview stay consistent.
 * Rendered on the Worker per request. The address it shares (QR, Share, saved contact, canonical,
 * Open Graph) is the configured permanent URL in every environment — see ~/lib/card/url.ts.
 */
import CardLayout from '~/layouts/CardLayout.astro';
import Logo from '~/components/brand/Logo.astro';
import { card, fullName } from '~/config/card';
import { siteConfig } from '~/config/site';
import { contactMethods, formatPhone } from '~/lib/card/contact.ts';
import { qrSvg } from '~/lib/card/qr.ts';
import { resolveCardPublicUrl, sameOrigin } from '~/lib/card/url.ts';
import { runtimeEnv } from '~/lib/runtime-env';
import { vcardFilename } from '~/lib/card/vcard.ts';

export const prerender = false;

// One permanent URL for every environment: CARD_PUBLIC_URL, else the config default.
const cardUrl = resolveCardPublicUrl(runtimeEnv().CARD_PUBLIC_URL, card.publicUrl, (bad) =>
  console.error(`[card] CARD_PUBLIC_URL is not a valid https URL ("${bad.slice(0, 80)}"); using the default`),
);
const name = fullName();
const methods = contactMethods(card);
const vcfName = vcardFilename(card.fileBase);
const shareText = `${name} — ${card.role}, ${card.business}`;
const title = `${name} — ${card.role}, ${card.business}`;
const description = card.description ?? `Digital business card for ${name}, ${card.role} of ${card.business}.`;
const hostLabel = (href: string) => new URL(href).host;

// Rows: the website first, then any configured links (labels/order come from the config).
const rows = [
  ...(card.website ? [{ label: 'Website', detail: hostLabel(card.website), href: card.website }] : []),
  ...card.links.map((l) => ({ label: l.label, detail: '', href: l.href })),
];
const qr = qrSvg(cardUrl, `QR code that opens ${name}'s card at ${cardUrl}`);

// Launch-animation layout (decorative). x/y are % of the logo stage; delays stagger the twinkles.
const PINK = 'var(--pink)';
const WHITE = 'var(--warm-white)';
const sparks = [
  { x: 9, y: 27, size: 1.15, delay: 0.45, tone: PINK },
  { x: 91, y: 21, size: 1.6, delay: 0.6, tone: WHITE },
  { x: 97, y: 63, size: 0.8, delay: 0.95, tone: PINK },
  { x: 4, y: 71, size: 1.3, delay: 0.8, tone: PINK },
  { x: 24, y: 7, size: 0.9, delay: 1.05, tone: WHITE },
  { x: 80, y: 91, size: 1.05, delay: 0.5, tone: PINK },
  { x: 52, y: 3, size: 0.75, delay: 1.1, tone: PINK },
  { x: 66, y: 12, size: 0.6, delay: 0.7, tone: WHITE },
];
const dust = [
  { x: 14, y: 82, delay: 0.6 }, { x: 28, y: 90, delay: 0.85 }, { x: 44, y: 94, delay: 0.7 },
  { x: 60, y: 88, delay: 1.0 }, { x: 74, y: 80, delay: 0.65 }, { x: 88, y: 74, delay: 0.95 },
  { x: 8, y: 52, delay: 0.9 }, { x: 93, y: 44, delay: 0.75 },
];

const icons: Record<string, string> = {
  call: 'M6.5 4h3L11 8l-2 1.5a11 11 0 0 0 5.5 5.5L16 13l4 1.5v3a2 2 0 0 1-2 2A14 14 0 0 1 4.5 6a2 2 0 0 1 2-2z',
  text: 'M4 5h16v11H9l-5 4z',
  email: 'M4 6h16v12H4zM4 7l8 6 8-6',
};
---
<CardLayout
  {title}
  {description}
  url={cardUrl}
  image={sameOrigin(cardUrl, card.previewImage)}
  imageAlt={card.previewImageAlt}
  siteName={`${siteConfig.name} — ${siteConfig.descriptor}`}
>
  <main id="main" class="card">
    <header class="top">
      <!-- Share / QR need JavaScript, so they only appear when it is available. -->
      <div class="top__utils rise-soft" data-js-only>
        <button type="button" class="util" data-share data-url={cardUrl} data-title={title} data-text={shareText}>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 15V4m0 0L8 8m4-4 4 4M5 12v7h14v-7" /></svg>
          <span>Share card</span>
        </button>
        <button type="button" class="util" data-qr-open aria-haspopup="dialog">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h2v2h-2zM18 14h2v2h-2zM14 18h2v2h-2zM18 18h2v2h-2z" /></svg>
          <span>Show QR code</span>
        </button>
      </div>
      <div class="stage">
        <Logo variant="full" width="20rem" eager class="top__logo" />
        <!-- Launch animation: purely decorative, plays once, then disappears (the finished logo is held). -->
        <div class="magic" aria-hidden="true">
          <svg class="magic__ring" viewBox="0 0 100 100" focusable="false">
            <circle cx="50" cy="50" r="46" pathLength="1" />
            <circle class="magic__ring--b" cx="50" cy="50" r="49" pathLength="1" />
          </svg>
          {sparks.map((s) => (
            <svg class="magic__spark" viewBox="-10 -10 20 20" focusable="false" style={`left:${s.x}%;top:${s.y}%;--s:${s.size}rem;--d:${s.delay}s;--c:${s.tone}`}>
              <path d="M0-10 2.5-2.5 10 0 2.5 2.5 0 10-2.5 2.5-10 0-2.5-2.5Z" />
            </svg>
          ))}
          {dust.map((d) => <i class="magic__dust" style={`left:${d.x}%;top:${d.y}%;--d:${d.delay}s`}></i>)}
        </div>
      </div>
    </header>

    <div class="body">
      <section class="who" aria-labelledby="card-name">
        <h1 id="card-name" class="t-display who__name rise" style="--i:0">{name}</h1>
        <p class="who__role t-label rise" style="--i:1">{card.role}</p>
        <p class="who__biz t-statement-sm rise" style="--i:2">{card.business}</p>
        {card.description && <p class="who__desc t-body t-muted">{card.description}</p>}
      </section>

      <div class="save rise" style="--i:4">
        <a class="btn save__btn" href={`/card/${vcfName}`} download={vcfName}>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11m0 0-4-4m4 4 4-4M5 19h14" /></svg>
          Save contact
        </a>
        <p class="save__hint">Downloads a contact file. Open it to add {card.givenName} to your contacts.</p>
      </div>

      {methods.length > 0 && (
        <nav class="methods rise" style="--i:6" aria-label={`Contact ${name}`}>
          {methods.map((m) => (
            <a class="method" href={m.href}>
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><path d={icons[m.kind]} /></svg>
              <span>{m.label}</span>
            </a>
          ))}
        </nav>
      )}
      {(card.phone || card.email) && (
        <p class="address rise" style="--i:7">
          {card.phone && <span>{formatPhone(card.phone.number)}</span>}
          {card.email && <span>{card.email}</span>}
        </p>
      )}

      {rows.length > 0 && (
        <ul class="rows list-reset rise" style="--i:8" role="list">
          {rows.map((r) => (
            <li>
              <a class="row" href={r.href}>
                <span class="row__label">{r.label}{r.detail && <span class="row__detail">{r.detail}</span>}</span>
                <span class="row__arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      )}

      {card.social.length > 0 && (
        <ul class="social list-reset" role="list" aria-label="Social profiles">
          {card.social.map((s) => <li><a class="social__link t-label" href={s.href} rel="me noopener">{s.label}</a></li>)}
        </ul>
      )}
    </div>

    <p class="toast t-label" role="status" aria-live="polite" data-toast></p>
  </main>

  <dialog class="qr" data-qr aria-labelledby="qr-title" data-js-only>
    <div class="qr__panel">
      <h2 id="qr-title" class="t-statement-sm">Scan to open this card</h2>
      <div class="qr__code" set:html={qr} />
      <p class="qr__url" data-qr-url>{cardUrl}</p>
      <form method="dialog"><button class="btn qr__close" autofocus>Close</button></form>
    </div>
  </dialog>
</CardLayout>

<style>
  html:not(.js) [data-js-only] { display: none !important; }

  .card { min-height: 100dvh; display: flex; flex-direction: column; }

  /* The logo's own charcoal ground runs edge to edge, so the artwork sits seamlessly on it. */
  .top { background: var(--charcoal); padding: max(0.25rem, env(safe-area-inset-top)) var(--gutter) var(--space-s); display: grid; justify-items: center; }
  .top__utils { justify-self: end; display: flex; gap: var(--space-2xs); margin-right: -0.5rem; }
  .util { display: inline-flex; align-items: center; gap: 0.5rem; min-height: var(--touch); padding: 0 0.6rem; color: var(--warm-white); font-size: 0.8125rem; font-weight: 500; letter-spacing: 0.04em; transition: color var(--dur-base); }
  .util:hover { color: var(--pink); }
  .stage { position: relative; width: min(20rem, 100%); }
  .top :global(.top__logo) { width: 100%; }

  /* ---------- Launch animation (decorative, one-time, CSS only: transform + opacity) ---------- */
  .magic { position: absolute; inset: 0; pointer-events: none; }
  .magic__ring { position: absolute; left: 50%; top: 50%; width: 94%; aspect-ratio: 1; translate: -50% -50%; overflow: visible; fill: none; stroke: var(--pink); stroke-width: 0.5; stroke-linecap: round; }
  .magic__ring circle { stroke-dasharray: 1; stroke-dashoffset: 1; transform-origin: 50% 50%; }
  .magic__ring--b { stroke: var(--warm-white); stroke-opacity: 0.7; }

  .magic__spark { position: absolute; width: var(--s); height: var(--s); translate: -50% -50%; fill: var(--c); opacity: 0; }
  .magic__dust { position: absolute; width: 3px; height: 3px; border-radius: 50%; background: var(--pink); opacity: 0; }

  @media (prefers-reduced-motion: no-preference) {
    /* The logo materialises, the spell-circle is traced around it, stars twinkle in, then it all clears
       and the finished logo is held. Whole sequence ≈ 2.7s; nothing blocks the buttons.
       `backwards` fill = elements return to their ordinary, un-animated state when they finish. */
    .top :global(.top__logo) { animation: logo-in 1.1s var(--ease-out) backwards; }
    .magic__ring { animation: ring-turn 2.5s linear 0.15s backwards; }
    .magic__ring circle { animation: ring-trace 2.5s var(--ease-in-out) 0.15s backwards; }
    .magic__ring .magic__ring--b { animation-delay: 0.4s; }
    .magic__spark { animation: twinkle 1.5s ease-in-out var(--d) backwards; }
    .magic__dust { animation: drift 1.7s ease-out var(--d) backwards; }
    .rise { animation: rise 0.8s var(--ease-out) backwards; animation-delay: calc(0.5s + var(--i, 0) * 0.1s); }
    .rise-soft { animation: fade-in 0.8s ease backwards; animation-delay: 0.9s; }

    @keyframes logo-in { from { opacity: 0; transform: scale(0.9); } }
    /* trace the circle (0–55%), hold, then fade it away (75–100%) */
    @keyframes ring-trace {
      0% { stroke-dashoffset: 1; stroke-opacity: 1; }
      55% { stroke-dashoffset: 0; stroke-opacity: 1; }
      72% { stroke-dashoffset: 0; stroke-opacity: 1; }
      100% { stroke-dashoffset: 0; stroke-opacity: 0; }
    }
    @keyframes ring-turn { from { rotate: -70deg; } to { rotate: 20deg; } }
    @keyframes twinkle {
      0% { opacity: 0; transform: scale(0) rotate(-40deg); }
      22% { opacity: 1; transform: scale(1) rotate(0deg); }
      50% { opacity: 0.55; transform: scale(0.6) rotate(15deg); }
      72% { opacity: 1; transform: scale(1.1) rotate(30deg); }
      100% { opacity: 0; transform: scale(0) rotate(60deg); }
    }
    @keyframes drift {
      0% { opacity: 0; transform: translateY(0) scale(0.6); }
      25% { opacity: 0.95; }
      100% { opacity: 0; transform: translateY(-2.75rem) scale(1.1); }
    }
    @keyframes rise { from { opacity: 0; transform: translateY(1rem); } }
    @keyframes fade-in { from { opacity: 0; } }
  }

  /* Reduced motion: no launch sequence at all — the finished card is shown immediately. */
  @media (prefers-reduced-motion: reduce) {
    .magic { display: none; }
  }

  .body { width: 100%; max-width: 30rem; margin-inline: auto; padding: var(--space-l) var(--gutter) max(var(--space-2xl), env(safe-area-inset-bottom)); display: grid; gap: var(--space-m); align-content: start; flex: 1; }

  .who { display: grid; gap: var(--space-2xs); }
  .who__name { font-size: clamp(3.25rem, 15vw, 4.75rem); overflow-wrap: anywhere; }
  .who__role { color: var(--pink); margin-top: var(--space-2xs); }
  .who__biz { color: var(--warm-white); }
  .who__desc { margin-top: var(--space-xs); }

  .save { display: grid; gap: var(--space-xs); margin-top: var(--space-xs); }
  .save__btn { min-height: 3.5rem; width: 100%; }
  .save__hint { color: var(--text-muted); font-size: var(--fs-small); }

  /* Contact methods: no boxes — icon over label, only the enabled ones. */
  .methods { display: flex; flex-wrap: wrap; gap: var(--space-l); margin-top: var(--space-s); }
  .method { display: grid; justify-items: center; gap: 0.35rem; min-width: 2.75rem; min-height: 3.5rem; padding: 0.25rem 0; font-size: 0.8125rem; font-weight: 500; letter-spacing: 0.06em; transition: color var(--dur-base); }
  .method:hover { color: var(--pink); }
  .address { display: grid; gap: 0.15rem; color: var(--text-muted); font-size: var(--fs-small); overflow-wrap: anywhere; margin-top: -0.5rem; }

  /* Links: plain text rows separated by hairlines, with a discreet arrow. */
  .rows { border-top: var(--border-thin); margin-top: var(--space-s); }
  .row { display: flex; align-items: center; justify-content: space-between; gap: var(--space-s); min-height: 3.5rem; border-bottom: var(--border-thin); transition: color var(--dur-base); }
  .row__label { font-weight: 500; display: grid; }
  .row__detail { color: var(--text-muted); font-size: var(--fs-small); font-weight: 400; overflow-wrap: anywhere; }
  .row__arrow { color: var(--text-muted); transition: transform var(--dur-base) var(--ease-out), color var(--dur-base); }
  .row:hover { color: var(--pink); }
  .row:hover .row__arrow { color: var(--pink); transform: translateX(0.25rem); }

  .social { display: flex; flex-wrap: wrap; gap: 0 var(--space-m); margin-top: var(--space-xs); }
  .social__link { display: inline-flex; align-items: center; min-height: var(--touch); color: var(--text-muted); transition: color var(--dur-base); }
  .social__link:hover { color: var(--pink); }

  /* Feedback toast (Share / copy): fixed, so it never shifts the layout. */
  .toast { position: fixed; left: 50%; bottom: max(1rem, env(safe-area-inset-bottom)); transform: translate(-50%, 0.5rem); max-width: calc(100% - 2rem); padding: 0.8rem 1.1rem; background: var(--warm-white); color: var(--noir); opacity: 0; pointer-events: none; text-align: center; transition: opacity var(--dur-base), transform var(--dur-base) var(--ease-out); z-index: 20; }
  .toast.is-on { opacity: 1; transform: translate(-50%, 0); }
  .toast:empty { display: none; }

  /* QR overlay */
  .qr { margin: auto; padding: 0; border: 1px solid var(--rule-strong); background: var(--noir); color: var(--warm-white); width: min(26rem, calc(100% - 2rem)); max-height: calc(100dvh - 2rem); overflow: auto; }
  .qr::backdrop { background: color-mix(in srgb, var(--noir-deep) 82%, transparent); }
  .qr__panel { display: grid; gap: var(--space-s); justify-items: center; padding: var(--space-m); text-align: center; }
  /* White tile + black modules: maximum contrast and reliable camera scanning. */
  .qr__code { width: min(100%, 20rem); background: #fff; line-height: 0; }
  .qr__code :global(svg) { width: 100%; height: auto; display: block; }
  .qr__url { font-size: var(--fs-small); color: var(--warm-white); overflow-wrap: anywhere; user-select: all; }
  .qr__close { width: 100%; min-height: 3rem; }

  @media (prefers-reduced-motion: reduce) {
    .toast, .row__arrow { transition: none; }
  }
</style>

<script>
  import '~/scripts/card';
</script>
