---
import '~/styles/global.css';
import Seo from '~/seo/Seo.astro';
import AnnouncementBar from '~/components/layout/AnnouncementBar.astro';
import Header from '~/components/layout/Header.astro';
import Footer from '~/components/layout/Footer.astro';
import CartDrawer from '~/components/commerce/CartDrawer.astro';
import SideHeader from '~/components/layout/SideHeader.astro';
import SideFooter from '~/components/layout/SideFooter.astro';
import ShopScripts from '~/components/layout/ShopScripts.astro';
import { siteConfig } from '~/config/site';

interface Props {
  title: string;
  description?: string;
  path?: string;
  image?: string;
  ogType?: 'website' | 'product' | 'article';
  noindex?: boolean;
  jsonLd?: object | object[];
  /**
   * Which frame wraps the page:
   *  - 'shop'        announcement bar, shop header, shop footer, cart (default)
   *  - 'divination'  slim header + footer, no cart
   *  - 'bare'        nothing but the page (the landing)
   */
  chrome?: 'shop' | 'divination' | 'bare';
}
const { title, chrome = 'shop', ...seo } = Astro.props;
const fullTitle = title.includes(siteConfig.name) ? title : `${title} — ${siteConfig.name} ${siteConfig.descriptor}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#171517" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/bebas-neue.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-var.woff2" as="font" type="font/woff2" crossorigin />
    <!-- Enables scroll-reveal start states only when JS is running (content is visible without it). -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <Seo title={fullTitle} {...seo} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {chrome === 'shop' && <><AnnouncementBar /><Header /></>}
    {chrome === 'divination' && <SideHeader current="divination" />}
    <main id="main">
      <slot />
    </main>
    {chrome === 'shop' && <><Footer /><CartDrawer /></>}
    {chrome === 'divination' && <SideFooter />}
    <script>
      import '~/scripts/reveal';
    </script>
    {chrome === 'shop' && <ShopScripts />}
  </body>
</html>
