# Build-time variables (set in the Cloudflare build settings; Astro inlines these during `npm run build`).
SITE_URL=https://lanoir.ca

# Set to "true" ONLY on the production (main) build. Anything else is served noindex.
PUBLIC_ALLOW_INDEXING=false

# Digital business card (/card): its ONE permanent public URL, used by the QR code, Share button,
# saved contact's "Digital card" field, canonical URL and Open Graph URL in EVERY environment (staging
# included). Independent of PUBLIC_ALLOW_INDEXING and never derived from the hostname. This is a
# RUNTIME variable (Cloudflare Variables / wrangler.jsonc `vars`), listed here for reference; it is
# optional because src/config/card.ts has the same default.
CARD_PUBLIC_URL=https://lanoir.ca/card

# Runtime variables and SECRETS (Square, COMMERCE_PROVIDER) do NOT belong here.
# Locally use .dev.vars (see .dev.vars.example); in Cloudflare use Variables and Secrets.
# See docs/SQUARE.md.
