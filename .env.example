# Public site URL (used for canonical URLs, sitemap, Open Graph).
SITE_URL=https://lanoir.example.com

# Set to "true" ONLY on the production (main) Cloudflare environment.
# Anything else (staging, previews, local) is served with noindex.
PUBLIC_ALLOW_INDEXING=false

# Commerce provider. Phase 1 supports "mock" only. "square" arrives in a later phase.
PUBLIC_COMMERCE_PROVIDER=mock
