{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Worker name. Confirmed: matches the Worker in the Cloudflare dashboard.
  "name": "lanoir",
  "compatibility_date": "2026-09-01",

  // `main` and the static-assets directory are generated by @astrojs/cloudflare at build time
  // (dist/server/wrangler.json); `wrangler deploy` / `wrangler preview` follow that redirect.

  // Serve prerendered pages at /about (not /about/), matching `trailingSlash: "never"` in astro.config.mjs.
  // /about/ redirects to /about. Keeps one canonical URL per page.
  "assets": { "html_handling": "drop-trailing-slash" },

  // Never wipe dashboard-managed variables on deploy. PRODUCTION Square settings
  // (SQUARE_ENVIRONMENT=production, production SQUARE_LOCATION_ID) and ALL secrets live in
  // the Cloudflare dashboard, not in git. See docs/SQUARE.md.
  "keep_vars": true,

  // Non-secret and identical everywhere: the digital card always shares its one permanent URL.
  // (Not derived from the hostname or PUBLIC_ALLOW_INDEXING — see src/lib/card/url.ts.)
  "vars": {
    "CARD_PUBLIC_URL": "https://lanoir.ca/card"
  },

  // PREVIEW = `npx wrangler preview` on `staging`. Uses the LIVE (production) Square catalogue so
  // staging shows the real products. These ids are not secrets. The production
  // SQUARE_ACCESS_TOKEN must be a Preview *secret* in Cloudflare (never committed).
  // Staging checkout would create real Square orders: do not complete a purchase on staging.
  "previews": {
    "vars": {
      "CARD_PUBLIC_URL": "https://lanoir.ca/card",
      "SQUARE_ENVIRONMENT": "production",
      "SQUARE_LOCATION_ID": "LE2GKGAWZDBE9"
    }
  }
}
